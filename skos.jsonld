      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1069",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Low-Friction Interaction",
        "@language": "en"
      },
      "skos:notation": "AUG-1069",
      "skos:definition": {
        "@value": "A condition of low-friction collaboration in which an AI-assisted task proceeds with few corrections, clarifications, or breakdowns. It denotes a graded smoothness of the working exchange rather than a single moment.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Smooth Sail",
          "@language": "en"
        },
        {
          "@value": "Ruhige Fahrt",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
