    {
      "@id": "https://augmanitai.com/terms/AUG-0204",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Conversational Afterimage",
        "@language": "en"
      },
      "skos:notation": "AUG-0204",
      "skos:definition": {
        "@value": "The aftereffect of an intensive AI session in which the user adopts formulations, thinking structures, or argumentation patterns from the AI dialogue into their everyday communication — often unconsciously. Related to AUG-0046 (The Felt Echo), AUG-0003 (Fluide Identitätsmorphologie), and AUG-0125 (The Feedback Effect).",
        "@language": "de"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
