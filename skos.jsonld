    {
      "@id": "https://augmanitai.com/terms/AUG-1004",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Reciprocal Humor Escalation",
        "@language": "en"
      },
      "skos:notation": "AUG-1004",
      "skos:definition": {
        "@value": "A self-reinforcing humorous exchange between a user and an AI system in which each party's playful turn prompts a further playful turn, lowering perceived tension. Distinguished from a single joke by its turn-to-turn escalation.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Loop Laugh",
          "@language": "en"
        },
        {
          "@value": "Loop-Lachen",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1037.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1046",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Humor-Framed Correction",
        "@language": "en"
      },
      "skos:notation": "AUG-1046",
      "skos:definition": {
        "@value": "A corrective AI response that frames a needed change to the user's input or assumption in a light, humorous register, lowering the user's resistance to the correction. Distinguished from a plain correction by its humorous framing.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Nudge Laugh",
          "@language": "en"
        },
        {
          "@value": "Schubs-Lachen",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1037.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1052",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Delayed Humor Recognition",
        "@language": "en"
      },
      "skos:notation": "AUG-1052",
      "skos:definition": {
        "@value": "A delayed humorous reaction in which the user first processes an AI output's literal meaning and only afterward perceives it as funny, often laughing at their own delayed comprehension. Distinguished from immediate humor by the lag between exposure and amusement.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Backward Laugh",
          "@language": "en"
        },
        {
          "@value": "Rückwärts-Lachen",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1037.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1037",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Input-Attribution Realization",
        "@language": "en"
      },
      "skos:notation": "AUG-1037",
      "skos:definition": {
        "@value": "A realization by the user that an unsatisfactory AI output stemmed from an unclear or underspecified prompt rather than from a model error, prompting the user to revise the input. Distinguished from generic insight by its attribution of shortfall to one's own input.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Adjustment Aha",
          "@language": "en"
        },
        {
          "@value": "Anpassungs-Aha",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1037.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0625",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Everyday Insight",
        "@language": "en"
      },
      "skos:notation": "AUG-0625",
      "skos:definition": {
        "@value": "An insight arising from AI interaction that the user reports as changing how they perceive an everyday phenomenon, such as a new perspective, an unexpected connection, or a useful reinterpretation. Distinguished from in-task problem-solving by its carry-over into ordinary life.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0368.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0670",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Rhetorical-Register Discrimination Ability",
        "@language": "en"
      },
      "skos:notation": "AUG-0670",
      "skos:definition": {
        "@value": "An individual user's graded ability to identify the rhetorical register of an AI output, for example whether it is serious, ironic, neutral, or exaggerated. Distinguished from comprehension of content by its focus on tone, and it varies across users.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0368.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
      },
      "skos:altLabel": {
        "@value": "The Rhetorical Tone Detector",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1050",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Deliberate Incoherent Prompting",
        "@language": "en"
      },
      "skos:notation": "AUG-1050",
      "skos:definition": {
        "@value": "A deliberately incoherent, heterogeneous prompt assembled by the user so that the AI system produces unexpected or creative combinations from the disparate elements. Distinguished from an ordinary prompt by its intentional internal inconsistency.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Surprise Salad",
          "@language": "en"
        },
        {
          "@value": "Überraschungs-Salat",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1050.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1040",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Tension-Release Humor",
        "@language": "en"
      },
      "skos:notation": "AUG-1040",
      "skos:definition": {
        "@value": "A targeted use of humor within an interaction intended to release built-up tension and restore the user's capacity to keep working. Distinguished from incidental humor by its deployment at a point of friction or stall.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Humor Hook",
          "@language": "en"
        },
        {
          "@value": "Humor-Haken",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1040.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1027",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Positive Affect Spike",
        "@language": "en"
      },
      "skos:notation": "AUG-1027",
      "skos:definition": {
        "@value": "A brief, unexpected moment of positive affect during an interaction that the user reports as releasing energy or lifting engagement. Distinguished from sustained mood by its short, punctate character.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Joy Jolt",
          "@language": "en"
        },
        {
          "@value": "Freude-Impuls",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1027.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1051",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Humor Cascade",
        "@language": "en"
      },
      "skos:notation": "AUG-1051",
      "skos:definition": {
        "@value": "A self-reinforcing sequence of humorous reactions across consecutive turns that produces a sense of lightness and can dislodge a cognitive block. Distinguished from a single humorous exchange by its escalating chain of three or more reactions.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Giggle Chain",
          "@language": "en"
        },
        {
          "@value": "Kicher-Kette",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1051.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1044",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Motivation Restoration",
        "@language": "en"
      },
      "skos:notation": "AUG-1044",
      "skos:definition": {
        "@value": "A short interaction intended to restore the user's motivation and positive mood after a dip. Distinguished from ongoing encouragement by its brief, bounded, restorative character.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Joy Fix",
          "@language": "en"
        },
        {
          "@value": "Freude-Fix",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1044.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1005",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Pause Power",
        "@language": "en"
      },
      "skos:notation": "AUG-1005",
      "skos:definition": {
        "@value": "The user's practice of deliberately inserting a pause between receiving an AI output and sending the next input, in order to avoid impulsive replies and improve the quality of the following prompt. Distinguished from incidental delay by its intentional, regulatory character.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Pause-Power",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1005.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0088",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Algorithmic Intuition",
        "@language": "en"
      },
      "skos:notation": "AUG-0088",
      "skos:definition": {
        "@value": "An experienced user's implicit, practice-acquired sense for which kind of input tends to yield which kind of result, applied without deliberate analysis each time. Distinguished from explicit prompting knowledge by being tacit and predictive rather than reasoned step by step.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0368.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1030",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Non-Frustrated Error Recovery",
        "@language": "en"
      },
      "skos:notation": "AUG-1030",
      "skos:definition": {
        "@value": "An AI error that the user consciously accepts and treats as a learning signal, responding with quick correction and continuation rather than annoyance. Distinguished from an unremarked error by the user's explicit non-frustrated, corrective response.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Oops Moment",
          "@language": "en"
        },
        {
          "@value": "Hups-Moment",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1030.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1059",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Day Highlight",
        "@language": "en"
      },
      "skos:notation": "AUG-1059",
      "skos:definition": {
        "@value": "A user's deliberate act of marking a positive moment from the day, often with AI support, to consolidate it emotionally. Distinguished from passive recall by the explicit selection and recording of the moment.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Tages-Highlight",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1059.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1012",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Minimal Calming Cue",
        "@language": "en"
      },
      "skos:notation": "AUG-1012",
      "skos:definition": {
        "@value": "A small verbal cue from the AI that elicits a disproportionately large sense of calm in the user. Distinguished from extended de-escalation by its minimal linguistic footprint relative to its calming effect.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Serenity Spark",
          "@language": "en"
        },
        {
          "@value": "Ruhe-Funke",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1012.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1054",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Playful Correction",
        "@language": "en"
      },
      "skos:notation": "AUG-1054",
      "skos:definition": {
        "@value": "An AI error correction delivered in a playful tone that preserves the user's willingness to learn rather than provoking defensiveness. Distinguished from a neutral correction by its playful register and its effect on receptiveness.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Fun Correct",
          "@language": "en"
        },
        {
          "@value": "Spaß-Korrektur",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1054.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1022",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Progress Reflection",
        "@language": "en"
      },
      "skos:notation": "AUG-1022",
      "skos:definition": {
        "@value": "A moment in which achieved progress is reflected back to the user, with the aim of strengthening their sense of self-efficacy. Distinguished from generic praise by its specific reference to concrete progress already made.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Pride Pulse",
          "@language": "en"
        },
        {
          "@value": "Stolz-Impuls",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1022.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1025",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Elevated Positive-Affect Passage",
        "@language": "en"
      },
      "skos:notation": "AUG-1025",
      "skos:definition": {
        "@value": "A heightened affective state of connection, joy, or meaning that a user reports during an interaction. Distinguished from a brief affect spike by being a sustained, graded condition rather than a single moment.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Heart High",
          "@language": "en"
        },
        {
          "@value": "Herzens-Hoch",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1025.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1032",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Error Composure",
        "@language": "en"
      },
      "skos:notation": "AUG-1032",
      "skos:definition": {
        "@value": "A user's disposition to register AI or task errors with composure because the learning value of the error is clearly apparent. Distinguished from a single calm reaction by being a graded, trait-like tendency across errors.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Learn Smile",
          "@language": "en"
        },
        {
          "@value": "Lern-Lächeln",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1032.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1058",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Serendipitous Finding",
        "@language": "en"
      },
      "skos:notation": "AUG-1058",
      "skos:definition": {
        "@value": "An unsought finding that the user did not set out to obtain but recognizes as valuable once it appears during interaction. Distinguished from a sought answer by its incidental, unplanned origin.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Discovery Ding",
          "@language": "en"
        },
        {
          "@value": "Entdeckungs-Ding",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
