        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1058.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1026",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Motivation Recovery",
        "@language": "en"
      },
      "skos:notation": "AUG-1026",
      "skos:definition": {
        "@value": "A targeted restoration of the user's motivation following frustration or exhaustion during an interaction. Distinguished from general encouragement by its placement after an explicit motivational low and its restorative intent.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Motivation Mend",
          "@language": "en"
        },
        {
          "@value": "Motivations-Reparatur",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1026.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1010",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Pace-Reduction Mode",
        "@language": "en"
      },
      "skos:notation": "AUG-1010",
      "skos:definition": {
        "@value": "A regulating interaction mode in which the AI deliberately reduces pace, sentence rhythm, and complexity to lower the user's perceived tempo. Distinguished from distraction by being a deliberate slowing of the exchange rather than a topic shift.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Calm Wave",
          "@language": "en"
        },
        {
          "@value": "Ruhe-Welle",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1010.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1029",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "State Gratitude Appraisal",
        "@language": "en"
      },
      "skos:notation": "AUG-1029",
      "skos:definition": {
        "@value": "A reflective state in which the user consciously notices positive aspects of an experience and anchors them emotionally, often prompted by the interaction. Distinguished from a fleeting good feeling by its deliberate, reflective appraisal.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Gratitude Glow",
          "@language": "en"
        },
        {
          "@value": "Dankbarkeits-Leuchten",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1029.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1034",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Productive Reframe",
        "@language": "en"
      },
      "skos:notation": "AUG-1034",
      "skos:definition": {
        "@value": "A creative change of direction in the interaction that initially disorients the user but then yields a new and better quality of output. Distinguished from an unproductive tangent by its eventual gain in output quality.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Twist Dance",
          "@language": "en"
        },
        {
          "@value": "Twist-Tanz",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1034.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1064",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Emotional Overload Reset",
        "@language": "en"
      },
      "skos:notation": "AUG-1064",
      "skos:definition": {
        "@value": "A deliberate act of resetting emotional overload so the user can re-engage with their own needs. Distinguished from ongoing self-soothing by being a discrete, marked break that re-orients the user after overload.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Heart Reset",
          "@language": "en"
        },
        {
          "@value": "Herzens-Reset",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1064.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1067",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Habitual Daily Integration",
        "@language": "en"
      },
      "skos:notation": "AUG-1067",
      "skos:definition": {
        "@value": "A habitual, recurring division of labor in which a user routinely incorporates an AI system into everyday tasks, such that the pairing becomes a settled part of the daily workflow rather than an occasional consultation.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Daily Duo",
          "@language": "en"
        },
        {
          "@value": "Tages-Duo",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1067.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1015",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Calm Shift",
        "@language": "en"
      },
      "skos:notation": "AUG-1015",
      "skos:definition": {
        "@value": "A discrete, user-recognized transition during an AI-assisted session from an agitated, problem-focused mode into a calmer, more reflective one, marked at the point where the interaction's tone and pace visibly shift.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Ruhe-Wechsel",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1015.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1018",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Felt-Coherence State",
        "@language": "en"
      },
      "skos:notation": "AUG-1018",
      "skos:definition": {
        "@value": "A self-reported moment of strong felt coherence during interaction, in which prior internal tension eases and the user reports a sense of things fitting together. The construct refers to the user's subjective state, not to any property of the AI.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Harmony Hug",
          "@language": "en"
        },
        {
          "@value": "Harmonie-Umarmung",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1018.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1023",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Momentary Optimism Appraisal",
        "@language": "en"
      },
      "skos:notation": "AUG-1023",
      "skos:definition": {
        "@value": "A transient elevated-affect appraisal during interaction in which the user weighs perceived possibilities as larger than perceived risks. It denotes the user's momentary optimistic stance toward options surfaced in the exchange.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Excitement Bubble",
          "@language": "en"
        },
        {
          "@value": "Begeisterungs-Blase",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1023.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1042",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Positive Pivot",
        "@language": "en"
      },
      "skos:notation": "AUG-1042",
      "skos:definition": {
        "@value": "A reformulation move in which a stated problem is recast into one or more actionable options. It denotes the observable act of converting a problem framing into a choice set within the dialogue.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Positiver Drehpunkt",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1042.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1066",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "No-Stress Swap",
        "@language": "en"
      },
      "skos:notation": "AUG-1066",
      "skos:definition": {
        "@value": "An act of replacing an overwhelming task specification with a more realistic, smaller-scope alternative during an AI-assisted exchange, observable as a deliberate substitution of the task under discussion.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Stress-Tausch",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1066.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1061",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Gratitude Turn",
        "@language": "en"
      },
      "skos:notation": "AUG-1061",
      "skos:definition": {
        "@value": "A turn in which a user's framing shifts from focusing on what is lacking to acknowledging what is valued, observable as an explicit appreciation statement within the dialogue.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Dankbarkeits-Dreh",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1061.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1006",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Divergent Ideation Burst",
        "@language": "en"
      },
      "skos:notation": "AUG-1006",
      "skos:definition": {
        "@value": "A bounded divergent-generation episode in which the dialogue deliberately prioritizes quantity of ideas over quality, with selection and evaluation deferred to a later phase. It denotes an ideation burst rather than an evaluative exchange.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Idea Rain",
          "@language": "en"
        },
        {
          "@value": "Ideen-Regen",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1006.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1014",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Relaxation Edit",
        "@language": "en"
      },
      "skos:notation": "AUG-1014",
      "skos:definition": {
        "@value": "A revision act applied to a text or message with the explicit aim of lowering its perceived pressure, harshness, or demand level while preserving its informational content.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Entspannungs-Überarbeitung",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1014.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1019",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Deliberate Slow Restart",
        "@language": "en"
      },
      "skos:notation": "AUG-1019",
      "skos:definition": {
        "@value": "A deliberate restart move in which a conversation or reasoning thread is returned to an earlier point to be re-begun more slowly and explicitly, observable as an intentional back-up and re-entry in the dialogue.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Calm Rewind",
          "@language": "en"
        },
        {
          "@value": "Ruhiger Rücklauf",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1019.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1043",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Calm Reset",
        "@language": "en"
      },
      "skos:notation": "AUG-1043",
      "skos:definition": {
        "@value": "A brief pause and re-centering taken after an intense stretch of AI-assisted work, allowing attention to recover before the next task. It denotes a short, in-rhythm micro-break distinct from extended rest.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Ruhe-Reset",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1043.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1055",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Goal-Match Acknowledgment",
        "@language": "en"
      },
      "skos:notation": "AUG-1055",
      "skos:definition": {
        "@value": "A point in an exchange at which the user registers shared satisfaction because the delivered output, the original intention, and the result align. It denotes a user-marked success acknowledgment within the dialogue.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "High-Five Moment",
