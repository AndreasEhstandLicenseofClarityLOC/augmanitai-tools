      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1040",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Humor Hook",
        "@language": "en"
      },
      "skos:notation": "AUG-1040",
      "skos:definition": {
        "@value": "Gezielter Humor, um Spannung zu lösen und Arbeitsfähigkeit zurückzugewinnen.",
        "@language": "de"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Humor-Haken",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
