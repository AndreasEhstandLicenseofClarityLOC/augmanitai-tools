      },
      "skos:notation": "AUG-0088",
      "skos:definition": {
        "@value": "The ability of experienced AI users to develop, through extended practice, a \"sense\" for which type of input produces which type of result — without having to consciously analyze this each time. Describes implicit knowledge about AI system behavior that forms through experience. Related to AUG-0133 (Prompt Craftsmanship), Phase 6 (Integrated Work State), and the System-Builder Profile (Profile 1).",
        "@language": "de"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
