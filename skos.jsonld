      "@id": "https://augmanitai.com/terms/AUG-0345",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Capability-Limit Encounter",
        "@language": "en"
      },
      "skos:notation": "AUG-0345",
      "skos:definition": {
        "@value": "The moment a user encounters the limits of an AI system: the system cannot solve the task, returns incorrect information, or exposes a comprehension boundary, giving the user direct evidence of what the system cannot do.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
