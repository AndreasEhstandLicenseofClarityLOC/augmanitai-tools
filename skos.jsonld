        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1037",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Adjustment Aha",
        "@language": "en"
      },
      "skos:notation": "AUG-1037",
      "skos:definition": {
        "@value": "Der Erkenntnismoment, dass nicht der Output falsch war, sondern die Eingabe unklar.",
        "@language": "de"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Anpassungs-Aha",
        "@language": "de"
      },
      "skos:broader": {
