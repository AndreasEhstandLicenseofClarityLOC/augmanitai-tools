      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1011",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Relaxation Breath",
        "@language": "en"
      },
      "skos:notation": "AUG-1011",
      "skos:definition": {
        "@value": "A brief AI-guided breathing or attention exercise intended to lower stress or ease a transition between cognitive states, observable as a discrete guided micro-intervention within the session.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Entspannungs-Atem",
        "@language": "de"
      },
      "skos:broader": {
