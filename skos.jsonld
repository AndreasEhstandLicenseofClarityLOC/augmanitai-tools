      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1036",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Error Normalization Stance",
        "@language": "en"
      },
      "skos:notation": "AUG-1036",
      "skos:definition": {
        "@value": "A user's working stance toward errors in which mistakes are treated as ordinary, expected by-products of productive work rather than as non-successes, lowering the threshold for surfacing and correcting them during AI-assisted tasks.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Mistake Friend",
          "@language": "en"
        },
        {
          "@value": "Fehler-Freund",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
