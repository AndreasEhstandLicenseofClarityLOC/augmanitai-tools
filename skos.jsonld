      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1003",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Collaborative Phrasing Refinement",
        "@language": "en"
      },
      "skos:notation": "AUG-1003",
      "skos:definition": {
        "@value": "A collaborative, iterative search for the single formulation that precisely fits meaning, tone, and context, defined by repeated refinement of candidate wordings until convergence on one expression.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Word Hunt",
          "@language": "en"
        },
        {
          "@value": "Wort-Jagd",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
