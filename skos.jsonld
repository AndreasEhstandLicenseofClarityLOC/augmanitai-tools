      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Drift Fix",
        "@language": "en"
      },
      "skos:notation": "AUG-1045",
      "skos:definition": {
        "@value": "A deliberate corrective move in which a user redirects a conversation that has wandered off back toward its core goal, re-anchoring the exchange to the original task within an AI dialogue.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Abdrift-Korrektur",
