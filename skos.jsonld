      "skos:definition": {
        "@value": "A deliberate injection of unstructured or disordered input intended to break out of an entrenched line of thinking; structure is reintroduced only in a subsequent step after the fixation is loosened.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
