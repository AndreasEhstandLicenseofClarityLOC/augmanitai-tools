        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1021.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1024",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Optimism Opener",
        "@language": "en"
      },
      "skos:notation": "AUG-1024",
      "skos:definition": {
        "@value": "A reframing that shifts the user's perspective toward opportunities and possible courses of action without denying or minimizing the existing problems.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Optimismus-Öffner",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1024.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1039",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Frustration-to-Openness Shift",
        "@language": "en"
      },
      "skos:notation": "AUG-1039",
      "skos:definition": {
        "@value": "A mental turn from frustration toward constructive openness, in which a user moves from a blocked, irritated stance to a receptive, solution-oriented one during an AI exchange.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Light Swing",
          "@language": "en"
        },
        {
          "@value": "Licht-Schwenk",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1039.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1048",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Soft Landing",
        "@language": "en"
      },
      "skos:notation": "AUG-1048",
      "skos:definition": {
        "@value": "The scaling-down of overreaching ideas into realistic, implementable steps, in which an AI exchange helps a user convert an oversized aim into a feasible sequence of actions.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Sanfte Landung",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1048.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1049",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Tension-to-Ease Shift",
        "@language": "en"
      },
      "skos:notation": "AUG-1049",
      "skos:definition": {
        "@value": "A transition from tension to ease brought about by small positive cues in an AI exchange, in which the user's strained state gives way to a lighter, more relaxed one.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Grin Shift",
          "@language": "en"
        },
        {
          "@value": "Grinsen-Wechsel",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1049.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1062",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Lightness Lift",
        "@language": "en"
      },
      "skos:notation": "AUG-1062",
      "skos:definition": {
        "@value": "The targeted reduction of a user's felt heaviness through linguistic or perspective-based relief, in which an AI exchange deliberately reframes or lightens the framing of a burdensome matter.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Leichtigkeits-Lift",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1062.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0089",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Pattern Sharpening",
        "@language": "en"
      },
      "skos:notation": "AUG-0089",
      "skos:definition": {
        "@value": "A longitudinal effect in which regular AI interaction is associated with improvement in a user's ability to recognize patterns in data, texts, or arguments, such that sustained use coincides with gains in the person's own analytic pattern detection.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0089.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0422",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Calibrated Trust",
        "@language": "en"
      },
      "skos:notation": "AUG-0422",
      "skos:definition": {
        "@value": "A graded user disposition in which the degree of acceptance granted to an AI output is scaled to its stakes: high-consequence outputs receive more independent verification, routine outputs receive proportionally lighter checking. Trust varies by context rather than being uniformly extended or withheld.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Das Kalibrierte Vertrauen",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0422.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0614",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Synthetic Spotting",
        "@language": "en"
      },
      "skos:notation": "AUG-0614",
      "skos:definition": {
        "@value": "A discrete user judgement that a given piece of content was produced by an AI system, inferred from stylistic regularities, characteristic phrasing, or content-level cues. The referent is the act of attribution, not the correctness of that attribution.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0614.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0775",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The AI Abstention Zone",
        "@language": "en"
      },
      "skos:notation": "AUG-0775",
      "skos:definition": {
        "@value": "A deliberately maintained boundary - spatial, temporal, or topical - within which a person excludes AI assistance. The referent is a standing, self-imposed restriction on the scope of AI use rather than a one-off refusal.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0775.html"
      },
      "skos:altLabel": {
        "@value": "The KI-Free Zone",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0260",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Narrative Divergence Prompt",
        "@language": "en"
      },
      "skos:notation": "AUG-0260",
      "skos:definition": {
        "@value": "A use episode in which a person enlists an AI system to generate unexpected narrative turns or alternative storylines for a creative or persuasive artefact such as a story, pitch, or argument. The referent is the request-and-use episode, not a property of the AI.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0260.html"
      },
      "skos:altLabel": {
        "@value": "The Plot Twist Partner",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0370",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Animal-Care Query",
        "@language": "en"
      },
      "skos:notation": "AUG-0370",
      "skos:definition": {
        "@value": "A use episode in which a person queries an AI system for information about animal care - feeding, behaviour, preventive health, or species-appropriate husbandry. The referent is a topically defined everyday information request.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0370.html"
      },
      "skos:altLabel": {
        "@value": "The Pet Lookup",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0430",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Workflow Reversion",
        "@language": "en"
      },
      "skos:notation": "AUG-0430",
      "skos:definition": {
        "@value": "A reversion episode in which a person returns to a previously used AI workflow after a newer alternative did not deliver the intended result. The referent is the act of reverting, reflecting that an established procedure outperformed a newer one for that task.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0430.html"
      },
      "skos:altLabel": {
        "@value": "The Vintage Loop",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0534",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Novel-Perspective Surfacing",
        "@language": "en"
      },
      "skos:notation": "AUG-0534",
      "skos:definition": {
        "@value": "A use episode in which an AI system surfaces a perspective on a familiar topic that the user reports not having considered before. The referent is the discovery event of a previously unconsidered viewpoint during interaction.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0534.html"
      },
      "skos:altLabel": {
        "@value": "The Hidden Angle Finder",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0639",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Duplicate Notice",
        "@language": "en"
      },
      "skos:notation": "AUG-0639",
      "skos:definition": {
        "@value": "A discrete recognition act in which a user identifies an AI response as substantively repeating an earlier response - reworded but identical in core content. The referent is the user's recognition of redundancy, not the redundancy itself.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0639.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0675",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Role-Aware Input",
        "@language": "en"
      },
      "skos:notation": "AUG-0675",
      "skos:definition": {
        "@value": "A prompt in which the user frames the request through an explicit social role - for example 'as a parent I need...' or 'in my capacity as...'. The referent is the role-marked formulation of an individual input.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0675.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0711",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Accent Persistence",
        "@language": "en"
      },
      "skos:notation": "AUG-0711",
      "skos:definition": {
        "@value": "The degree to which structural features of a user's first language - word order, punctuation conventions, and phrasing patterns - remain detectable in their written AI inputs composed in a second language. The referent is the relative strength of cross-linguistic transfer in writing.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0711.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0901",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Emergent Coordination",
        "@language": "en"
      },
      "skos:notation": "AUG-0901",
      "skos:definition": {
        "@value": "An occurrence in a multi-agent system of a coordination pattern that was not explicitly specified, arising from the interaction of components rather than from any single component's design. The referent is the observed unspecified coordinated behaviour.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0901.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0001",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Augmanitai",
        "@language": "en"
      },
      "skos:notation": "AUG-0001",
      "skos:definition": {
        "@value": "A superordinate framework term for the deliberate, productive collaboration between humans and AI in everyday contexts, viewed from the human side. It blends 'augmentation' with a coined 'humanitai' root and, unlike 'artificial intelligence', foregrounds the human's experience and agency rather than the machine.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0001.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0005",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Integrated Operator",
        "@language": "en"
      },
      "skos:notation": "AUG-0005",
      "skos:definition": {
        "@value": "A user mode in which a person no longer treats AI as a separate tool but moves fluidly between their own thinking and AI assistance without a distinct switching moment. The referent is an advanced, relatively stable working state characterised by low perceived separation between human and AI activity.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0005.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0016",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Cross-Domain Synthesis",
        "@language": "en"
      },
      "skos:notation": "AUG-0016",
      "skos:definition": {
        "@value": "An output in which an AI-assisted user integrates knowledge from several distinct disciplines into a single interdisciplinary result. The referent is an instance of cross-domain synthesis produced with on-demand access to domain knowledge.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0016.html"
      },
      "skos:altLabel": {
        "@value": "Poly-Categorical Mesh",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0047",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Post-Affirmation Advocacy",
        "@language": "en"
      },
      "skos:notation": "AUG-0047",
      "skos:definition": {
        "@value": "An episode in which a user, after an affirming AI interaction, becomes more willing to advance an idea to other people. The referent is the subsequent real-world advocacy act, with the prior AI exchange serving as an initial sounding board.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0047.html"
      },
      "skos:altLabel": {
        "@value": "The Echo Courage",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0092",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Output Asymmetry",
        "@language": "en"
      },
      "skos:notation": "AUG-0092",
      "skos:definition": {
        "@value": "The relationship in which the effort needed to produce a result falls substantially under AI assistance while the quantity or quality of the result is maintained or increased. The referent is the changed ratio of input effort to output yield.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0092.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0999",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Forward Assessment",
        "@language": "en"
      },
      "skos:notation": "AUG-0999",
      "skos:definition": {
        "@value": "An utterance that attempts to anticipate how the human-AI relationship will develop while explicitly acknowledging the uncertainty of any such forecast. The referent is the hedged, future-oriented assessment act; the surrounding lexicon documents the present rather than predicting it.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0999.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0041",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Tangential-Output Serendipity",
        "@language": "en"
      },
      "skos:notation": "AUG-0041",
      "skos:definition": {
        "@value": "An episode in which an off-target or tangential AI output - content not directly matching the query - triggers an unanticipated association or idea connection in the user. The referent is the serendipitous association event arising from output 'noise'.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0041.html"
      },
      "skos:altLabel": {
        "@value": "The Scatter Spark",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0194",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Positive Surprise",
        "@language": "en"
      },
      "skos:notation": "AUG-0194",
      "skos:definition": {
        "@value": "An AI response that exceeds the user's prior expectations in quality, depth, or perspective. The referent is the discrete expectation-exceeding response event, which is associated with an increase in the user's trust in the collaboration.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0194.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0220",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Differential Gratitude Expression",
        "@language": "en"
      },
      "skos:notation": "AUG-0220",
      "skos:definition": {
        "@value": "The pattern in which some users express gratitude toward an AI more freely than toward people, attributed to the absence of social-evaluation concern in the AI exchange. The referent is the relative difference in expressed gratitude between AI-directed and human-directed communication.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0220.html"
      },
      "skos:altLabel": {
        "@value": "The Gratitude Paradox",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0305",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Seasonal User",
        "@language": "en"
      },
      "skos:notation": "AUG-0305",
      "skos:definition": {
        "@value": "A user whose AI-use intensity rises and falls over time with life phase, project load, or season, alternating intensive daily periods with extended pauses. The referent is the longitudinal, non-linear pattern of usage intensity for an individual.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0305.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0330",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Source Curiosity",
        "@language": "en"
      },
      "skos:notation": "AUG-0330",
      "skos:definition": {
        "@value": "A user's move to trace the origin or grounding of an AI-generated statement - asking where a claim comes from or on what it is based. The referent is the discrete provenance-seeking act during interaction.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Die Quellen-Neugier",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0330.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0435",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Meal-Planning Query",
        "@language": "en"
      },
      "skos:notation": "AUG-0435",
      "skos:definition": {
        "@value": "A brief AI query made for an everyday food decision, such as what to cook from available ingredients or what side dish fits a meal. The referent is a low-effort, topically defined household information request.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
