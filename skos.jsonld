      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1052",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Backward Laugh",
        "@language": "en"
      },
      "skos:notation": "AUG-1052",
      "skos:definition": {
        "@value": "Humor, der zeitversetzt wirkt: Erst versteht man den Witz, dann lacht man über die eigene Reaktion darauf.",
        "@language": "de"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Rückwärts-Lachen",
        "@language": "de"
      },
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
