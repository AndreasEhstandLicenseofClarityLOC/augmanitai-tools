    {
      "@id": "https://augmanitai.com/terms/AUG-0204",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Conversational Afterimage",
        "@language": "en"
      },
      "skos:notation": "AUG-0204",
      "skos:definition": {
        "@value": "The aftereffect of an intensive AI session in which a user later carries over formulations, thinking structures, or argumentation patterns from the dialogue into their everyday communication, often without awareness of the source.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
