        "@language": "en"
      },
      "skos:notation": "AUG-1049",
      "skos:definition": {
        "@value": "Der Übergang von Anspannung zu Leichtigkeit durch kleine positive Impulse.",
        "@language": "de"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
