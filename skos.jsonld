      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1028",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Optional Creative Prompt",
        "@language": "en"
      },
      "skos:notation": "AUG-1028",
      "skos:definition": {
        "@value": "A light creative prompt or suggestion offered without any obligation to act on it, functioning as an optional spark rather than a directive within the exchange.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
