    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0520",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Inquiry Chain Cascade",
        "@language": "en"
      },
      "skos:notation": "AUG-0520",
      "skos:definition": {
        "@value": "An exploration episode in which one AI question leads to a chain of follow-up questions that draws the user progressively deeper into a topic, analogous to a 'Wikipedia hole' but driven by AI dialogue. The referent is the extended, self-propagating inquiry episode.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0520.html"
      },
      "skos:altLabel": {
        "@value": "The Wiki Wormhole",
        "@language": "en"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0565",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Balance Filter",
        "@language": "en"
      },
      "skos:notation": "AUG-0565",
      "skos:definition": {
        "@value": "A standing self-regulation strategy for keeping AI use proportionate to non-digital activity through fixed times, rules, or routines, so that AI supplements rather than overtakes daily life. The referent is the maintained regulatory arrangement, not a single instance of restraint.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0565.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0981",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Companion Pattern",
        "@language": "en"
      },
      "skos:notation": "AUG-0981",
      "skos:definition": {
        "@value": "A standing usage mode in which a person incorporates AI assistance into daily routines as a steady accompaniment for thinking, drafting, and exploration, operating alongside rather than in place of their own reflection. The referent is the co-present, habitual mode of use.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Das Begleiter-Muster",
        "@language": "de"
      },
