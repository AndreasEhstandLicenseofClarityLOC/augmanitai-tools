      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1013",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Supportive Warmth Style",
        "@language": "en"
      },
      "skos:notation": "AUG-1013",
      "skos:definition": {
        "@value": "An emotionally supportive interaction style that conveys safety, belonging, and acceptance without forcing problem-solving. It denotes a graded stylistic quality of the exchange as perceived by the user.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Feel-Good Warm",
          "@language": "en"
        },
        {
          "@value": "Wohlfühl-Wärme",
          "@language": "de"
        }
      ],
      "skos:broader": {
