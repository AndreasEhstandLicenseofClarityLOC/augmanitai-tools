        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1069.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1060",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Specific Gratitude Reference",
        "@language": "en"
      },
      "skos:notation": "AUG-1060",
      "skos:definition": {
        "@value": "A single, concrete point of focus that makes gratitude specific and tangible, observable as one explicitly named object of appreciation within the exchange.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Gratitude Drop",
          "@language": "en"
        },
        {
          "@value": "Dankbarkeits-Tropfen",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
