      "skos:prefLabel": {
        "@value": "Lightness Lift",
        "@language": "en"
      },
      "skos:notation": "AUG-1062",
      "skos:definition": {
        "@value": "Das gezielte Reduzieren innerer Schwere durch sprachliche oder perspektivische Entlastung.",
        "@language": "de"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
