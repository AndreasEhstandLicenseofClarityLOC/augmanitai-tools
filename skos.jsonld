      "@id": "https://augmanitai.com/terms/AUG-1035",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Gentle Nudge",
        "@language": "en"
      },
      "skos:notation": "AUG-1035",
      "skos:definition": {
        "@value": "A minimal reminder or correction that provides orientation without exerting pressure, observable as a brief, low-intensity prompt that redirects without using demand language.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Sanfter Schubs",
