          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1016.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1021",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Low-Pressure Encouragement",
        "@language": "en"
      },
      "skos:notation": "AUG-1021",
      "skos:definition": {
        "@value": "A small, friendly affirmation from the AI that gives the user a brief lift in energy or motivation without creating performance pressure or implying an obligation to perform.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Energy Kiss",
          "@language": "en"
        },
        {
          "@value": "Energie-Kuss",
          "@language": "de"
        }
      ],
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect"
      },
      "skos:related": [
        {
