      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1017",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Gentle Layer",
        "@language": "en"
      },
      "skos:notation": "AUG-1017",
      "skos:definition": {
        "@value": "An added emotional or linguistic layer that buffers harshness and makes communication more tolerable without distorting the underlying content. It denotes a graded softening property of a message relative to its plain form.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Sanfte Schicht",
        "@language": "de"
      },
      "skos:broader": {
