      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0625",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Everyday Insight",
        "@language": "en"
      },
      "skos:notation": "AUG-0625",
      "skos:definition": {
        "@value": "An insight gained through AI interaction that changes the user in everyday life — a new perspective on an everyday phenomenon, a surprising connection, or a helpful reinterpretation. Related to AUG-0292 (The View Shift), AUG-0248 (The Surprise Angle), and AUG-0054 (Augmented Understanding).",
        "@language": "de"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0368.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-0670",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "The Rhetorical Tone Detector",
        "@language": "en"
      },
      "skos:notation": "AUG-0670",
      "skos:definition": {
        "@value": "The individual ability of a user to recognize and classify the rhetorical tone of an AI output — whether the AI formulates seriously, ironically, neutrally, or exaggeratingly. This ability varies strongly between users. Related to AUG-0669 (The Rhetorical Style Differential), AUG-0668 (The Humor Portability), and AUG-0451 (The Token Awareness).",
        "@language": "de"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:broader": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology"
      },
      "skos:related": [
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html"
        },
        {
          "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0368.html"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html"
      }
    },
    {
      "@id": "https://augmanitai.com/terms/AUG-1050",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Surprise Salad",
        "@language": "en"
      },
      "skos:notation": "AUG-1050",
      "skos:definition": {
        "@value": "Ein bewusst chaotischer Input-Mix, aus dem die KI unerwartete, oft kreative Kombinationen erzeugt. Surprise Salad lebt vom Mut zur Inkohärenz.",
        "@language": "de"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": {
        "@value": "Überraschungs-Salat",
        "@language": "de"
      },
