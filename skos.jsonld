    {
      "@id": "https://augmanitai.com/terms/AUG-1031",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Mid-Task Micro-Correction",
        "@language": "en"
      },
      "skos:notation": "AUG-1031",
      "skos:definition": {
        "@value": "A brief, precise intervention that brings an output back on course without interrupting the overall working flow, observable as a short steering correction inserted mid-task.",
        "@language": "en"
      },
      "skos:inScheme": "https://augmanitai.com/terms/",
      "skos:altLabel": [
        {
          "@value": "Correction Kick",
          "@language": "en"
        },
        {
          "@value": "Korrektur-Kick",
          "@language": "de"
        }
      ],
      "skos:broader": {
