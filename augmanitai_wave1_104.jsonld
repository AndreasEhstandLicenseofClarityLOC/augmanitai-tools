    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1015",
      "name": "Calm Shift",
      "description": "Ein klar benannter Übergang von einem hektischen, problemlastigen Modus in einen ruhigeren, reflektierenden Zustand.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1015",
      "alternateName": "Ruhe-Wechsel",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "A Calm Shift is observed when a participant's mind-wandering frequency decreases following an AI-mediated calming-interaction, measured by experience-sampling probes administered before and after the interaction.",
      "measurementSchema": "Mind-wandering experience sampling: random probes (8-12 per hour) asking whether attention is on-task or wandering, administered for 60 minutes pre- and 60 minutes post-AI-interaction. Calm Shift = pre-post reduction in wandering-proportion via paired-samples test.",
      "exampleData": "{\"session_id\": \"S480\", \"participant\": \"P102\", \"probes_pre\": 10, \"wandering_pre_proportion\": 0.6, \"probes_post\": 11, \"wandering_post_proportion\": 0.27, \"shift_magnitude\": 0.33, \"paired_t\": 3.4}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1015.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1033.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1016.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1008.html"
      ],
      "inclusionCriteria": "Pre- and post-windows each containing >= 6 valid experience-sampling probes.",
      "exclusionCriteria": "Participants engaging in unrelated demanding task during post-window."
    },
