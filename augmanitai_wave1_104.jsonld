    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1051",
      "name": "Giggle Chain",
      "description": "Eine sich selbst verstärkende Abfolge humorvoller Reaktionen, die Leichtigkeit erzeugt und kognitive Blockaden löst.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1051",
      "alternateName": "Kicher-Kette",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "A Giggle Chain is observed when a cascade of humor-events occurs across three or more consecutive turns in an AI-mediated session, each turn containing a humor-marker and each contributing escalating or transforming the prior humor-element.",
      "measurementSchema": "Sequence pattern mining (PrefixSpan algorithm) over humor-marker token sequences identifying chains of length >= 3. Chain-quality = chain length x escalation-coherence rating (1-5 by trained coders).",
      "exampleData": "{\"session_id\": \"S418\", \"participant\": \"P098\", \"chains_detected\": 4, \"max_chain_length\": 7, \"mean_escalation_coherence\": 4.1, \"chain_quality_max\": 28.7}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1051.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1006.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1018.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1026.html"
      ],
      "inclusionCriteria": "At least 3 consecutive humor-marked turns within 5-turn window.",
      "exclusionCriteria": "Chains broken by topic-shift or single-side humor maintenance."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1044",
      "name": "Joy Fix",
      "description": "Kurze Intervention, um Motivation und positive Stimmung wiederherzustellen.",
