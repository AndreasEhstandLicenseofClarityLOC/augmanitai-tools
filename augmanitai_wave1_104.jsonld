    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1062",
      "name": "Lightness Lift",
      "description": "Das gezielte Reduzieren innerer Schwere durch sprachliche oder perspektivische Entlastung.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1062",
      "alternateName": "Leichtigkeits-Lift",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Operational scope: an instance of 'Lightness Lift' is counted when the observable pattern described above (Das gezielte Reduzieren innerer Schwere durch sprachliche oder perspektivische E...) occurs at least once within a defined interaction segment of N turns (typically N=10), as coded by trained raters.",
      "measurementSchema": "Self-report Likert (1-7) on perceived humor-loop strength after a session; complementary indicator: laughter-event count per minute.",
      "exampleData": "{\"session_id\": \"S001\", \"participant\": \"P001\", \"humor_loop_likert\": 5, \"laughter_events_per_min\": 1.2}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
