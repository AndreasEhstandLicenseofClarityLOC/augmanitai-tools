    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0368",
      "name": "The Syntax Smile",
      "description": "The brief pleasure a user feels when the AI delivers a particularly elegant, apt, or surprisingly beautiful formulation. Related to AUG-0194 (The Positive Surprise), AUG-0110 (The Joy Imperative), and AUG-0031 (Semantic Spark).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0368",
      "about": "compendium",
      "operationalDefinition": "A Syntax Smile is recorded when a participant expresses spontaneous positive affect (smile, brief laugh, positive interjection) at the syntactic structure or phrasing of an AI utterance independent of its content, verified by facial-action coding and verbal markers.",
      "measurementSchema": "Facial Action Coding System (FACS) applied to video-recorded sessions: detection of AU6+AU12 (Duchenne smile) within 5 seconds of AI-utterance onset, cross-referenced with the participant's verbal confirmation that the smile was triggered by phrasing. Inter-coder agreement via percentage-agreement on FACS labels.",
      "exampleData": "{\"session_id\": \"S145\", \"participant\": \"P073\", \"ai_utterances_n\": 42, \"syntax_smiles_n\": 6, \"facs_agreement_pct\": 0.89, \"verbal_confirmations\": 5}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0368.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0016.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0999.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0204.html"
      ],
      "inclusionCriteria": "FACS AU6+AU12 within 5s of AI-utterance plus verbal participant confirmation that phrasing was the trigger.",
      "exclusionCriteria": "Smiles attributable to content-humour rather than phrasing or syntactic structure."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0918",
      "name": "The Gesture Language",
      "description": "The communication between humans and embodied AI systems through gestures — hand signals, posture, movements that the system recognizes and interprets. Related to AUG-0917 (The Touch Interface), AUG-0919 (The Spatial Awareness), and AUG-0914 (The Physical Presence).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0918",
      "about": "compendium",
      "operationalDefinition": "The Gesture Language is observed in video-recorded AI-mediated sessions when participants develop reproducible non-verbal gestures (pointing, swiping, drawing-air-paths) accompanying their verbal AI-interaction, often co-occurring with spatial-reasoning content.",
      "measurementSchema": "Action Identification Theory (AIT) level coding applied to gesture-verb pairs: each gesture is coded as low-level (concrete motor-act) or high-level (abstract intentional-act). Gesture-language richness = high-level proportion x gesture-vocabulary size.",
      "exampleData": "{\"session_id\": \"S204\", \"participant\": \"P065\", \"gesture_events_total\": 38, \"ait_high_level_proportion\": 0.42, \"gesture_vocabulary_size\": 9, \"richness_index\": 3.78}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0918.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0194.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0204.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0430.html"
      ],
      "inclusionCriteria": "Video-recorded session with at least 20 codable gesture events.",
      "exclusionCriteria": "Sessions where gestures are confined to keyboard or device-input only."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0975",
      "name": "The Vigilance Rhythm",
      "description": "The observation that sustained AI-output verification benefits from a paced cadence: deliberate verification at chosen checkpoints rather than continuous monitoring. A rhythm of focused review and trusted intervals preserves attention quality over longer interactions.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0975",
      "about": "compendium",
      "alternateName": "Der Aufmerksamkeits-Rhythmus",
      "operationalDefinition": "The Vigilance Rhythm is observed when participants display cyclic patterns of high and low verification-effort across sessions, evidenced by alternation between verification-intensive and verification-sparse phases over time.",
      "measurementSchema": "Friedman test (non-parametric repeated-measures) applied to verification-rate across consecutive session-blocks (3-session blocks). Significant Friedman chi-square indicates non-random rhythmic variation; effect-size W reported.",
      "exampleData": "{\"participant\": \"P051\", \"blocks_analysed\": 12, \"verification_rate_range\": \"[0.18, 0.84]\", \"friedman_chi_square\": 27.4, \"kendalls_W\": 0.61, \"rhythm_period_blocks\": 4}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0975.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0089.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0092.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0001.html"
      ],
      "inclusionCriteria": "At least 30 sessions to support 10 or more blocks.",
      "exclusionCriteria": "Participants with monotonic increase or decrease in verification (no rhythm)."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1002",
      "name": "Quick Kick",
      "description": "Ein extrem kurzer, präziser Prompt mit sofortiger Wirkung auf Motivation, Fokus oder Entscheidungsfähigkeit. Kein Tiefgang, sondern Startenergie.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1002",
      "alternateName": "Quick-Kick",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Quick Kick is observed when brief sub-60-second AI-interactions produce a measurable mood-lift in the participant, evidenced by positive-affect increase on a state-affect scale immediately following the brief interaction.",
      "measurementSchema": "Kendall tau correlation between interaction-duration (in seconds, capped at 60s) and a single-item visual-analogue mood-lift score administered 60 seconds post-interaction across n >= 40 brief sessions. Quick Kick effectiveness = tau effect-size paired with median mood-lift magnitude.",
      "exampleData": "{\"sessions_n\": 48, \"participant\": \"P078\", \"mean_interaction_duration_s\": 42, \"kendall_tau\": -0.31, \"p_value\": 0.004, \"median_mood_lift_vas\": 18}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1002.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1027.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1011.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1035.html"
      ],
      "inclusionCriteria": "Interaction duration < 90 seconds AND mood-lift VAS administered post-interaction.",
      "exclusionCriteria": "Sessions with multiple interactions within the 60-second post-window."
    },
