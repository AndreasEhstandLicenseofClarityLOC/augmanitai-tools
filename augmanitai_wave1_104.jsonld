        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1023.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1061.html"
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1049",
      "name": "Grin Shift",
      "description": "Der Übergang von Anspannung zu Leichtigkeit durch kleine positive Impulse.",
