    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1003",
      "name": "Word Hunt",
      "description": "Der kollaborative Suchprozess nach der einen Formulierung, die Bedeutung, Ton und Kontext exakt trifft. Entscheidend ist das iterative Nachschärfen.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1003",
      "alternateName": "Wort-Jagd",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Word Hunt is observed when participants engage in playful AI-mediated lexical-exploration sessions seeking targeted vocabulary (rare words, technical terms, evocative synonyms), characterised by iterative narrowing prompts.",
      "measurementSchema": "Working memory span (Daneman-Carpenter reading span) administered pre- and post-engagement period, paired with vocabulary-retention assessment on hunted-words at 7-day follow-up. Word-Hunt benefit = retention x span improvement composite.",
      "exampleData": "{\"participant\": \"P032\", \"span_pre\": 3.5, \"span_post\": 4.0, \"words_hunted\": 42, \"retained_at_day_7\": 31, \"retention_rate\": 0.74, \"benefit_composite\": 0.37}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1003.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1050.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1047.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1023.html"
      ],
      "inclusionCriteria": "At least 30 hunted-words AND completed working-memory assessment at both timepoints.",
      "exclusionCriteria": "Participants whose hunt-targets duplicate existing vocabulary in baseline assessment."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1011",
      "name": "Relaxation Breath",
      "description": "Eine kurze, angeleitete Atem- oder Aufmerksamkeitsintervention durch die KI, um Stress zu senken oder einen Übergang zwischen kognitiven Zuständen zu ermöglichen.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1011",
      "alternateName": "Entspannungs-Atem",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Relaxation Breath is observed when an AI-guided brief breathing-pacing interaction produces measurable respiratory-rate slowing and vagal-tone change in the participant within a 4-minute exposure window.",
      "measurementSchema": "Polyvagal Theory ventral-vagal indices computed from respiratory-sinus-arrhythmia (RSA) recording: RSA-amplitude pre and post AI-guided session. Relaxation Breath confirmed when RSA-amplitude increase >= 0.5 ln(ms^2) AND respiratory rate decrease >= 3 breaths/min.",
      "exampleData": "{\"session_id\": \"S322\", \"participant\": \"P084\", \"rsa_pre_ln_ms2\": 5.8, \"rsa_post_ln_ms2\": 6.5, \"resp_rate_pre_bpm\": 16, \"resp_rate_post_bpm\": 11, \"vagal_index_change\": 0.7}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1011.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1016.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1066.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1013.html"
      ],
      "inclusionCriteria": "Concurrent respiratory and ECG recording for RSA computation across pre/post windows.",
      "exclusionCriteria": "Participants with documented respiratory disease."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1013",
      "name": "Feel-Good Warm",
      "description": "Ein emotional unterstützender Interaktionsstil, der Sicherheit, Zugehörigkeit und Akzeptanz vermittelt – ohne Problemlösung zu erzwingen.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1013",
      "alternateName": "Wohlfühl-Wärme",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Feel-Good Warm is observed when AI-mediated interactions produce a sustained low-arousal positive-affect state in the participant, characterised by warm-positive affect markers persisting for >= 15 minutes post-interaction.",
      "measurementSchema": "Schwartz Values Survey administered alongside intra-class correlation (ICC 3,1) on a 6-item warm-affect single-item-set sampled at three post-interaction timepoints (immediate, 15-min, 30-min). Sustained warmth detected when ICC > 0.7 AND value-orientation scores point to benevolence > self-direction.",
      "exampleData": "{\"session_id\": \"S360\", \"participant\": \"P092\", \"warm_score_immediate\": 5.6, \"warm_score_15min\": 5.5, \"warm_score_30min\": 5.3, \"icc_3_1\": 0.83, \"schwartz_benevolence\": 5.2, \"schwartz_self_direction\": 4.1}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1013.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1030.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1011.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1038.html"
      ],
      "inclusionCriteria": "All three post-interaction warm-affect probes completed AND Schwartz Values Survey within 30 days.",
      "exclusionCriteria": "Participants reporting concurrent mood-altering substances within the warmth-window."
    },
    {
      "@type": "DefinedTerm",
