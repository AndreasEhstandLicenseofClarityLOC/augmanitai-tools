    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1043",
      "name": "Calm Reset",
      "description": "A brief pause and re-center after intense AI interaction, allowing energy to return before the next task. Distinct from extended rest — a short reset built into the work rhythm.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1043",
      "alternateName": "Ruhe-Reset",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Calm Reset is observed when a brief AI-mediated grounding exchange following a stress-event returns the participant's affective state toward baseline within 10 minutes, measured by valence and arousal indicators.",
      "measurementSchema": "Affect Grid (valence-arousal 2D) administered at three timepoints: pre-stress, post-stress, post-reset. Reset effectiveness = (post-stress to post-reset Euclidean distance) / (post-stress to pre-stress Euclidean distance) on the 9x9 grid.",
      "exampleData": "{\"session_id\": \"S412\", \"participant\": \"P088\", \"pre_stress_grid\": \"[6,3]\", \"post_stress_grid\": \"[2,8]\", \"post_reset_grid\": \"[5,4]\", \"reset_effectiveness\": 0.78, \"reset_duration_min\": 8}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1043.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1057.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1020.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1002.html"
      ],
      "inclusionCriteria": "Identifiable stress-event AND all three Affect-Grid administrations completed.",
      "exclusionCriteria": "Participants who report concurrent pharmacological mood-regulation."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1055",
      "name": "High-Five Moment",
      "description": "Der Moment gemeinsamer Zufriedenheit, wenn Output, Intention und Ergebnis übereinstimmen.",
