  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1004",
      "name": "Loop Laugh",
      "description": "Ein selbstverstärkender Humor-Loop zwischen Mensch und KI, der Spannung abbaut und Fehler entdramatisiert. Funktional, nicht kindisch.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1004",
      "alternateName": "Loop-Lachen",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "A Loop Laugh is recorded when both partners (human + AI assistant) produce humor-elements within two consecutive turns AND the human signals levity through at least one observable cue: laugh-emoji, 'haha'/'lol'-tokens, an explicit laughter-cue ('that's funny'), or a positive sentiment-shift greater than 0.3 in the next turn. One-sided humor without reciprocal acknowledgment is excluded.",
      "measurementSchema": "Event-count per session normalized per 10 turns, complemented by a 7-point Likert post-session rating of perceived conversational lightness. Inter-rater agreement on humor-event coding measured via Cohen's kappa across two trained raters.",
      "exampleData": "{\"session_id\": \"S001\", \"participant\": \"P017\", \"duration_min\": 22, \"mutual_humor_events\": 5, \"humor_events_per_10_turns\": 1.8, \"lightness_likert\": 6, \"rater_kappa\": 0.82}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1037.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1027.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1034.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1028.html"
      ],
      "inclusionCriteria": "Both partners generate humor and the human signals levity within a 2-turn window.",
      "exclusionCriteria": "Sarcastic, hostile, or one-sided humor lacking reciprocal acknowledgment."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1046",
      "name": "Nudge Laugh",
      "description": "Eine humorvolle Korrektur, die Akzeptanz erleichtert.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1046",
      "alternateName": "Schubs-Lachen",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "A Nudge Laugh is recorded when a brief humor-cue from the AI assistant (one short witty remark, pun, or playful reframing) elicits a human levity-response within the immediately following turn. The AI utterance must be under 30 tokens and not the central content of the turn.",
      "measurementSchema": "Binary annotation per AI-turn (nudge-present yes/no), paired with binary human-response (levity-signal in next turn yes/no). Hit-rate computed as proportion of nudges that elicit a levity-signal. Token-length of nudge-utterance recorded for stratified analysis.",
      "exampleData": "{\"session_id\": \"S007\", \"participant\": \"P009\", \"ai_nudges_total\": 8, \"human_levity_responses\": 5, \"nudge_hit_rate\": 0.625, \"mean_nudge_tokens\": 14}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1037.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1025.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1018.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1043.html"
      ],
      "inclusionCriteria": "Brief (<30 token) AI humor-cue followed by human levity-signal in the next turn.",
      "exclusionCriteria": "Extended humorous exchanges, jokes longer than 30 tokens, or unsolicited human-initiated humor."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1052",
      "name": "Backward Laugh",
      "description": "Humor, der zeitversetzt wirkt: Erst versteht man den Witz, dann lacht man über die eigene Reaktion darauf.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1052",
      "alternateName": "Rückwärts-Lachen",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "A Backward Laugh is recorded when a participant retrospectively expresses amusement about an earlier exchange (typically 5-50 turns prior) through phrases such as 'looking back that was funny', 'I just realized', or by explicitly referencing a past humorous moment. The trigger must reference a specific prior turn rather than general session impression.",
      "measurementSchema": "Retrospective-reference coding scheme: count of backward humor-references per session, with mean lag-distance (number of turns between trigger and referenced moment). Coded by trained raters from full transcript with timestamp markers.",
      "exampleData": "{\"session_id\": \"S014\", \"participant\": \"P024\", \"backward_laugh_count\": 3, \"mean_lag_turns\": 18.5, \"median_lag_turns\": 14, \"transcript_length_turns\": 86}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1037.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1007.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1005.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1068.html"
      ],
      "inclusionCriteria": "Explicit retrospective reference to an earlier specific turn paired with amusement marker.",
      "exclusionCriteria": "Generic positive session-summary statements without reference to a specific earlier turn."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1037",
      "name": "Adjustment Aha",
      "description": "Der Erkenntnismoment, dass nicht der Output falsch war, sondern die Eingabe unklar.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1037",
      "alternateName": "Anpassungs-Aha",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "An Adjustment Aha is recorded when a participant experiences a sudden realisation about how to refine a prompt or interaction-pattern, verbalised within 30 seconds of the realisation and followed by an immediate measurable interaction-style change in the next 3 turns.",
      "measurementSchema": "Galvanic Skin Response (GSR) peak-detection at realisation-moment paired with verbal aha-marker capture. Style-change quantified via stylometric distance (cosine similarity on n-gram features) between pre-aha and post-aha turn-windows. Aha-event valid when GSR peak co-occurs with verbal marker and style-distance above threshold.",
      "exampleData": "{\"session_id\": \"S171\", \"participant\": \"P103\", \"aha_events_n\": 3, \"mean_gsr_peak_microsiemens\": 1.8, \"verbal_marker_match\": 3, \"mean_style_distance\": 0.42}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1037.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1006.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1045.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1058.html"
      ],
      "inclusionCriteria": "GSR peak co-occurring with verbal aha-marker plus stylistic distance above 0.3 in subsequent turn-window.",
      "exclusionCriteria": "GSR peaks attributable to external stimuli (interruption, ambient noise) confirmed via concurrent sensor data."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0625",
      "name": "The Everyday Insight",
      "description": "An insight gained through AI interaction that changes the user in everyday life — a new perspective on an everyday phenomenon, a surprising connection, or a helpful reinterpretation. Related to AUG-0292 (The View Shift), AUG-0248 (The Surprise Angle), and AUG-0054 (Augmented Understanding).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0625",
      "about": "compendium",
      "operationalDefinition": "An Everyday Insight is recorded when a participant reports a novel realization arising from a routine AI interaction (cooking, scheduling, casual question) within 24 hours of the exchange, including a verbal description of (a) the trigger turn, (b) the realization content, and (c) the application context.",
      "measurementSchema": "Diary-study with daily prompts over 14 days: free-text insight entries scored by two raters on a 0-3 novelty rubric (0=no insight, 1=restatement, 2=connection, 3=novel reframing). Frequency = insights per day; depth = mean novelty score.",
      "exampleData": "{\"diary_id\": \"D004\", \"participant\": \"P018\", \"days_logged\": 14, \"insights_total\": 9, \"insights_per_day\": 0.64, \"mean_novelty\": 1.9, \"rater_agreement_icc\": 0.78}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0368.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0005.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0001.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0534.html"
      ],
      "inclusionCriteria": "Diary entry within 24h linking a routine AI exchange to a stated realization.",
      "exclusionCriteria": "Insights from explicit problem-solving sessions or task-instructed reflection."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0670",
      "name": "The Rhetorical Tone Detector",
      "description": "The individual ability of a user to recognize and classify the rhetorical tone of an AI output — whether the AI formulates seriously, ironically, neutrally, or exaggeratingly. This ability varies strongly between users. Related to AUG-0669 (The Rhetorical Style Differential), AUG-0668 (The Humor Portability), and AUG-0451 (The Token Awareness).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0670",
      "about": "compendium",
      "operationalDefinition": "Rhetorical Tone Detection is recorded when a participant correctly identifies the rhetorical register (e.g., ironic, hedging, declarative, evasive, conciliatory) of an AI utterance from a closed-set of labels, with optional free-text justification. Detection is assessed on standardized stimulus passages.",
      "measurementSchema": "Forced-choice classification task on n=30 AI-generated passages across 6 tone-categories. Accuracy reported as proportion correct; sensitivity/specificity per category. Free-text justifications coded for evidence-quality on a 3-point rubric (cue-based / partial / unsupported).",
      "exampleData": "{\"session_id\": \"S045\", \"participant\": \"P011\", \"stimuli_n\": 30, \"accuracy\": 0.77, \"tone_categories\": 6, \"justification_quality_mean\": 2.4, \"weakest_category\": \"hedging\"}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0368.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0047.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0092.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0711.html"
      ],
      "inclusionCriteria": "Closed-set label selection with rationale linked to textual cues.",
      "exclusionCriteria": "Random or pattern-only responding without justification cues."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1050",
      "name": "Surprise Salad",
      "description": "Ein bewusst chaotischer Input-Mix, aus dem die KI unerwartete, oft kreative Kombinationen erzeugt. Surprise Salad lebt vom Mut zur Inkohärenz.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1050",
      "alternateName": "Überraschungs-Salat",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Surprise Salad is observed when AI generates an unexpected combinatorial output (mixing disparate domains, registers, or genres) that the participant rates as enjoyable rather than confusing, measured by domain-distance and enjoyment rating.",
      "measurementSchema": "Spectral clustering of session-embeddings applied to output-content vectors: salad-output detected when output spans >= 3 distinct clusters at silhouette > 0.4. Enjoyment rated on 9-point hedonic scale.",
      "exampleData": "{\"session_id\": \"S356\", \"participant\": \"P090\", \"output_clusters_spanned\": 4, \"silhouette_score\": 0.51, \"hedonic_rating\": 8, \"domain_distance_mean\": 0.68}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1050.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1059.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1039.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1067.html"
      ],
      "inclusionCriteria": "Multi-domain output identifiable AND hedonic rating completed.",
      "exclusionCriteria": "Outputs where the user explicitly requested a mash-up (no surprise component)."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1040",
      "name": "Humor Hook",
      "description": "Gezielter Humor, um Spannung zu lösen und Arbeitsfähigkeit zurückzugewinnen.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1040",
      "alternateName": "Humor-Haken",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Operational scope: an instance of 'Humor Hook' is counted when the observable pattern described above (Gezielter Humor, um Spannung zu lösen und Arbeitsfähigkeit zurückzugewinnen....) occurs at least once within a defined interaction segment of N turns (typically N=10), as coded by trained raters.",
      "measurementSchema": "Self-report Likert (1-7) on perceived humor-loop strength after a session; complementary indicator: laughter-event count per minute.",
      "exampleData": "{\"session_id\": \"S001\", \"participant\": \"P001\", \"humor_loop_likert\": 5, \"laughter_events_per_min\": 1.2}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1040.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1006.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1028.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1032.html"
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1027",
      "name": "Joy Jolt",
      "description": "Ein kurzer, unerwarteter Moment von Freude, der Energie freisetzt.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1027",
      "alternateName": "Freude-Impuls",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Operational scope: an instance of 'Joy Jolt' is counted when the observable pattern described above (Ein kurzer, unerwarteter Moment von Freude, der Energie freisetzt....) occurs at least once within a defined interaction segment of N turns (typically N=10), as coded by trained raters.",
      "measurementSchema": "Self-report Likert (1-7) on perceived humor-loop strength after a session; complementary indicator: laughter-event count per minute.",
      "exampleData": "{\"session_id\": \"S001\", \"participant\": \"P001\", \"humor_loop_likert\": 5, \"laughter_events_per_min\": 1.2}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1027.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
