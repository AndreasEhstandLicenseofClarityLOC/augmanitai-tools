    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1005",
      "name": "Pause Power",
      "description": "Die bewusste Unterbrechung zwischen Output und neuem Input, um impulsive Reaktionen zu vermeiden und die Qualität der nächsten Frage zu erhöhen.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1005",
      "alternateName": "Pause-Power",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Pause Power is observed when participants deliberately introduce reflection-pauses between AI-prompts, measured by inter-prompt latency longer than the participant's individual median, with downstream output-quality improvements.",
      "measurementSchema": "Reflective vs Impulsive (Reflection-Impulsivity Task, e.g., Matching Familiar Figures Test) administered alongside log-derived inter-prompt latency distribution. Pause Power = reflection-score x latency-quality slope.",
      "exampleData": "{\"participant\": \"P052\", \"mfft_reflection_score\": 18, \"median_inter_prompt_latency_s\": 47, \"latency_quality_slope\": 0.31, \"pause_power_index\": 5.58}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1005.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1065.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1059.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1050.html"
      ],
      "inclusionCriteria": "Reflection-Impulsivity assessment completed AND at least 50 prompt-pairs logged for latency analysis.",
      "exclusionCriteria": "Participants whose latency is dominated by external interruptions."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0088",
      "name": "Algorithmic Intuition",
      "description": "The ability of experienced AI users to develop, through extended practice, a \"sense\" for which type of input produces which type of result — without having to consciously analyze this each time. Describes implicit knowledge about AI system behavior that forms through experience. Related to AUG-0133 (Prompt Craftsmanship), Phase 6 (Integrated Work State), and the System-Builder Profile (Profile 1).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0088",
      "about": "compendium",
      "operationalDefinition": "Algorithmic Intuition is recorded when a participant produces a correct or near-correct prediction of an AI system's output before viewing it, accompanied by a verbal rationale that references prior interaction patterns rather than guessing. Operationally instantiated as a pre-output prediction task with confidence rating.",
      "measurementSchema": "Prediction-accuracy task: participants predict AI output on n=20 standardized prompts before reveal, scored by semantic-similarity (BERTScore) between prediction and actual output. Confidence reported on 5-point scale per item. Composite score = accuracy x confidence calibration.",
      "exampleData": "{\"session_id\": \"S031\", \"participant\": \"P003\", \"prompts_n\": 20, \"mean_bertscore\": 0.71, \"mean_confidence\": 3.8, \"calibration_error\": 0.12, \"experience_months\": 14}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0368.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0005.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0194.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0305.html"
      ],
      "inclusionCriteria": "Pre-output prediction grounded in stated prior-interaction reasoning.",
      "exclusionCriteria": "Random guesses or predictions made after partial output reveal."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1030",
      "name": "Oops Moment",
      "description": "Der bewusst akzeptierte Fehltritt der KI, der als Lernsignal genutzt wird. Kein Ärger, sondern schnelle Korrektur und Weitergehen.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1030",
      "alternateName": "Hups-Moment",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "An Oops Moment is observed when participants explicitly mark a failure or error in AI output with playful (rather than frustrated) framing, evidenced by playful-error markers (lol, haha, oops, oh no, oh dear) within two turns of the error.",
      "measurementSchema": "Goal Orientation scale (mastery vs performance, 8 items) administered alongside utterance-lexicon coding of error-framing (playful vs frustrated). Oops-Moment rate = playful-coded errors / total recognised errors, with mastery-goal-orientation hypothesised as positive predictor in logistic regression.",
      "exampleData": "{\"participant\": \"P083\", \"errors_recognised\": 18, \"playful_coded\": 14, \"frustrated_coded\": 4, \"mastery_orientation_score\": 5.2, \"performance_orientation_score\": 3.1, \"oops_rate\": 0.78, \"logistic_odds_ratio\": 2.4}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1030.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1035.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1034.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1023.html"
      ],
      "inclusionCriteria": "Identifiable error AND Goal Orientation scale completed within 14 days.",
      "exclusionCriteria": "Errors leading to immediate session-termination."
    },
