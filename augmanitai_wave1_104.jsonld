    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1010",
      "name": "Calm Wave",
      "description": "Ein regulierender Interaktionsmodus, bei dem die KI bewusst Tempo, Sprachrhythmus und Komplexität reduziert, um das wahrgenommene Tempo zu senken. Calm Wave ist kein Ablenken, sondern ein gezieltes Runterfahren.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1010",
      "alternateName": "Ruhe-Welle",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "Calm Wave is observed when an AI-mediated brief interaction induces measurable parasympathetic activation in the participant, characterised by elevated heart-rate variability and self-reported relaxation, within a 5-minute exposure window.",
      "measurementSchema": "HRV (Heart Rate Variability) inter-beat intervals analysed for RMSSD and high-frequency power (HF-HRV) before and after the AI interaction. Calm Wave detected when RMSSD increase >= 10ms AND self-reported relaxation increase >= 2 points on a 10-point scale.",
      "exampleData": "{\"session_id\": \"S301\", \"participant\": \"P081\", \"rmssd_pre_ms\": 32, \"rmssd_post_ms\": 47, \"hf_hrv_delta_ms2\": 184, \"relaxation_pre\": 4, \"relaxation_post\": 7}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1010.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1069.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1032.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1023.html"
      ],
      "inclusionCriteria": "ECG or PPG-validated HRV recording with at least 5 minutes pre- and post-baselines.",
      "exclusionCriteria": "Participants on beta-blockers or with documented arrhythmia."
    },
