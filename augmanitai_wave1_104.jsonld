    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0204",
      "name": "The Conversational Afterimage",
      "description": "The aftereffect of an intensive AI session in which the user adopts formulations, thinking structures, or argumentation patterns from the AI dialogue into their everyday communication — often unconsciously. Related to AUG-0046 (The Felt Echo), AUG-0003 (Fluide Identitätsmorphologie), and AUG-0125 (The Feedback Effect).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0204",
      "about": "compendium",
      "operationalDefinition": "The Conversational Afterimage is observed when conversational themes from prior sessions persist as residual framings in the participant's reasoning during a subsequent solo task, measured by lexical and conceptual carryover across an idle interval.",
      "measurementSchema": "Cross-recurrence quantification analysis (CRQA) applied to lexical-feature vectors from prior conversation transcript and subsequent solo-task transcript. Afterimage-strength = recurrence-rate (RR) and determinism (DET) metrics across the cross-recurrence plot.",
      "exampleData": "{\"prior_session_id\": \"S100\", \"solo_task_id\": \"T100b\", \"idle_interval_hours\": 18, \"recurrence_rate\": 0.27, \"determinism\": 0.61, \"max_diagonal_length\": 8}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0204.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0001.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0565.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0330.html"
      ],
      "inclusionCriteria": "Idle interval between 12 and 72 hours with both prior conversation and subsequent solo task available.",
      "exclusionCriteria": "Solo tasks where participant explicitly re-reads prior conversation during the task."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0045",
      "name": "Indexical Memory",
      "description": "The shift of the memory function from content knowledge to knowledge about storage location. The user no longer remembers the information itself but where and how to retrieve it via AI. Describes a fundamental shift in personal knowledge management in the AI era. Related to AUG-0014 (The Extended Mind Map) and AUG-0015 (The Outer Mind).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0045",
      "about": "compendium",
      "operationalDefinition": "Indexical Memory is observed when participants retrieve session-specific content via deictic markers (this, that, here, then) rather than via content-features, with successful retrieval rate measured against ground-truth transcript references.",
      "measurementSchema": "Hidden Markov Model state-transition probabilities estimated over deictic-marker sequences: states are deictic categories (proximal-temporal, distal-temporal, proximal-spatial, distal-spatial), transitions capture indexical-retrieval patterns. Retrieval-success rate = correct ground-truth match within 3-turn window.",
      "exampleData": "{\"session_id\": \"S173\", \"participant\": \"P074\", \"deictic_markers_total\": 28, \"successful_retrievals\": 21, \"retrieval_success_rate\": 0.75, \"hmm_log_likelihood\": -42.8}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0045.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0918.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0711.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0089.html"
      ],
      "inclusionCriteria": "At least 10 deictic markers per session with verifiable transcript anchors.",
      "exclusionCriteria": "Deictic uses lacking identifiable referent in the transcript."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0345",
      "name": "The Wall Check",
      "description": "The moment a user encounters the limits of an AI system — the AI cannot solve the task, provides faulty information, or reveals comprehension limits. Describes the productive experience of learning a system's limitations. Related to Axiom 9 (Productive Skepticism), AUG-0177 (The Trust Setting), and AUG-0176 (The Capability Discovery).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0345",
      "about": "compendium",
      "operationalDefinition": "The Wall Check is observed when participants use AI to probe whether a proposed approach will encounter known constraints or hard limits, characterised by explicit constraint-enumeration prompts followed by constraint-validation responses.",
      "measurementSchema": "Kullback-Leibler divergence between the participant's pre-check probability-distribution over feasibility-outcomes and the post-check distribution, elicited via brief 5-item feasibility-rating instrument. Larger KL = larger informational update from the wall-check.",
      "exampleData": "{\"session_id\": \"S091\", \"participant\": \"P035\", \"constraints_probed\": 7, \"kl_divergence_pre_post\": 1.84, \"feasibility_shift_direction\": \"more_constrained\", \"check_duration_min\": 9}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0345.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0711.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0430.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0918.html"
      ],
      "inclusionCriteria": "Pre-check and post-check feasibility ratings both completed.",
      "exclusionCriteria": "Sessions without an identifiable constraint-enumeration phase."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1007",
      "name": "Clarity Click",
      "description": "Der abrupte Übergang von diffuser Unsicherheit zu klarer mentaler Struktur, oft ausgelöst durch eine präzise Spiegelung der KI.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1007",
      "alternateName": "Klarheits-Klick",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "A Clarity Click is observed when participants experience a sudden subjective click-of-understanding during an AI-mediated explanation, evidenced by explicit click-markers (oh that's it, now I get it, click, makes sense now) and downstream demonstration of correct understanding.",
      "measurementSchema": "Wisconsin Card Sorting Task perseveration-errors administered before and after the explanation-session: clarity click hypothesised to reduce perseveration. Click-events flagged from transcript paired with perseveration delta.",
      "exampleData": "{\"session_id\": \"S404\", \"participant\": \"P095\", \"click_events\": 3, \"wcst_perseveration_pre\": 12, \"wcst_perseveration_post\": 6, \"perseveration_reduction\": 6, \"click_correlated\": true}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1007.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1027.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1012.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1009.html"
      ],
      "inclusionCriteria": "Click-marker AND WCST administered within 30 minutes of session.",
      "exclusionCriteria": "Click claims without downstream understanding-demonstration."
    },
