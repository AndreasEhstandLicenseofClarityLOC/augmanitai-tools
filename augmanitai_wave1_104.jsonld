    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1012",
      "name": "Serenity Spark",
      "description": "Ein kleiner sprachlicher Impuls, der unverhältnismäßig viel innere Ruhe auslöst. Oft minimal, aber emotional wirksam.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1012",
      "alternateName": "Ruhe-Funke",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "A Serenity Spark is observed when an AI-mediated brief exchange triggers a sudden subjective serenity state in the participant, characterised by a single-moment shift toward low-arousal positive affect with sustained reflective quality.",
      "measurementSchema": "Dispositional Mindfulness Scale (FFMQ - Five Facet Mindfulness Questionnaire) administered alongside event-marked self-report: participant taps marker at serenity-onset moment then completes a 4-item serenity-state scale. Spark-rate = markers per hour x FFMQ-observing-facet score.",
      "exampleData": "{\"session_id\": \"S425\", \"participant\": \"P100\", \"ffmq_observing\": 28, \"spark_markers\": 3, \"serenity_state_mean\": 5.4, \"spark_rate_per_hour\": 1.5, \"spark_quality_index\": 42.0}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1012.html",
      "citation": "https://zenodo.org/communities/augmanitai",
