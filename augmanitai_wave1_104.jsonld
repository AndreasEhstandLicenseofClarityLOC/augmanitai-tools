      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0089",
      "name": "The Pattern Sharpening",
      "description": "The effect whereby a user, through regular AI interaction, improves their ability to recognize patterns in data, texts, or arguments — the AI indirectly trains the human's pattern recognition. Describes a positive feedback effect of AI use on human analytical ability. Related to AUG-0054 (Augmented Understanding) and AUG-0088 (Algorithmic Intuition).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0089",
      "about": "compendium",
      "operationalDefinition": "The Pattern Sharpening is observed when iterative AI exchange reduces the noise-to-signal ratio in a participant's working representation of a recurring pattern, evidenced by progressive narrowing of the variance in pattern-defining features across successive articulations within one session.",
      "measurementSchema": "Time-series autocorrelation function (ACF) computed on feature-vectors extracted per turn from the participant's pattern-description statements. Sharpening = monotonic decrease in feature-variance with positive lag-1 autocorrelation rho >= 0.6 indicating coherent narrowing.",
      "exampleData": "{\"session_id\": \"S145\", \"participant\": \"P062\", \"turns_analysed\": 14, \"initial_variance\": 0.82, \"final_variance\": 0.21, \"acf_lag1\": 0.71}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0089.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0711.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0639.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0005.html"
      ],
      "inclusionCriteria": "At least 8 successive pattern-articulations with measurable feature-variance decrease.",
      "exclusionCriteria": "Sessions where the pattern is reframed mid-stream (topic-shift breaking the autocorrelation series)."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0422",
      "name": "The Calibrated Trust",
      "description": "The user practice of matching AI-output confidence to verification effort: high-stakes outputs receive verification, routine outputs receive proportional checks. Trust is shaped by context rather than uniformly granted or withheld.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0422",
      "about": "compendium",
      "alternateName": "Das Kalibrierte Vertrauen",
      "operationalDefinition": "Calibrated Trust is observed when a participant's expressed trust in specific AI outputs correlates with the AI's actual accuracy on those outputs across a verification window, measured by trust-accuracy calibration curves.",
      "measurementSchema": "Brier score for participant trust-ratings (0-1) vs. ground-truth accuracy (0/1) across at least 50 outputs. Reliability and resolution components reported; calibration plotted with 10 equal-width bins.",
      "exampleData": "{\"participant\": \"P070\", \"outputs_evaluated\": 64, \"brier_score\": 0.18, \"reliability_component\": 0.04, \"resolution_component\": 0.11, \"calibration_slope\": 0.94}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0422.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0435.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0975.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0430.html"
      ],
      "inclusionCriteria": "At least 50 trust-rated outputs with verifiable ground-truth.",
      "exclusionCriteria": "Outputs lacking objective accuracy criterion."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0614",
      "name": "The Synthetic Spotting",
      "description": "The ability to recognize AI-generated content — through stylistic features, typical formulation patterns, or content indicators. Related to AUG-0378 (The Turing Suspicion), AUG-0452 (The Reality Blur), and AUG-0088 (Algorithmic Intuition).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0614",
      "about": "compendium",
      "operationalDefinition": "The Synthetic Spotting capacity is observed when participants accurately identify AI-generated content in mixed-provenance text-sets across multiple domains, measured via forced-choice classification accuracy above chance.",
      "measurementSchema": "Item Response Theory (IRT) 2PL model fitted to participant-by-item accuracy matrix, with discrimination parameter a and difficulty parameter b estimated per item. Spotting-ability theta reported per participant on the standard IRT scale.",
      "exampleData": "{\"participant\": \"P063\", \"items_n\": 60, \"accuracy_pct\": 78, \"irt_theta\": 1.42, \"irt_theta_se\": 0.21, \"domain_consistency_alpha\": 0.81}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0614.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0999.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0422.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0918.html"
      ],
      "inclusionCriteria": "At least 50 items spanning at least 3 content-domains.",
      "exclusionCriteria": "Items where stylistic AI-fingerprints are explicitly disclosed."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0775",
      "name": "The KI-Free Zone",
      "description": "The conscious establishment of areas — spatial, temporal, or thematic — in which AI use is excluded. Related to AUG-0773 (The Conscious Refusal), AUG-0632 (The Offline Moment), and AUG-0565 (The Balance Filter).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0775",
      "about": "compendium",
      "operationalDefinition": "The KI-Free Zone is observed when participants deliberately demarcate temporal, spatial, or topical contexts as off-limits for AI consultation, with the demarcation explicitly stated and adhered-to across the observation window.",
      "measurementSchema": "Moderation analysis with interaction term: AI-availability x zone-membership predicting actual-AI-use, with zone-membership as binary moderator. Significant interaction = effective zone-demarcation.",
      "exampleData": "{\"participant\": \"P049\", \"zones_declared\": 3, \"zone_observations_total\": 124, \"ai_use_in_zone_pct\": 4, \"ai_use_outside_zone_pct\": 67, \"interaction_term_b\": -2.18, \"p_value\": 0.0001}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0775.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0565.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0204.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0901.html"
      ],
      "inclusionCriteria": "Explicit zone-declaration AND at least 50 observation-points spanning in-zone and out-of-zone contexts.",
      "exclusionCriteria": "Zones declared but not observable in available logs."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0260",
      "name": "The Plot Twist Partner",
      "description": "The use of AI as a creative sparring partner for narrative twists — in stories, presentations, pitches, or argumentation chains. Describes the AI's function as a supplier of unexpected plot changes and alternative storylines. Related to AUG-0235 (The Brainstorm Spark), AUG-0248 (The Surprise Angle), and the Experimenter Profile (Profile 4).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0260",
      "about": "compendium",
      "operationalDefinition": "The Plot Twist Partner is observed when the AI introduces unexpected narrative or framing shifts that the participant explicitly recognises as productive perturbation rather than disruption, indicated by a positive evaluation marker within two turns of the twist-event.",
      "measurementSchema": "Information-theoretic surprisal (Shannon entropy) computed per AI-turn on the next-token-prediction distribution from a baseline LM, with twist-events flagged as surprisal > 95th percentile. Productive-twist rate = proportion of twist-events followed by positive evaluation markers within 2 turns.",
      "exampleData": "{\"session_id\": \"S087\", \"participant\": \"P028\", \"twist_events\": 6, \"productive_twist_count\": 4, \"productive_twist_rate\": 0.67, \"mean_surprisal_at_twist\": 7.2}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0260.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0001.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0534.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0430.html"
      ],
      "inclusionCriteria": "Surprisal > 95th-percentile AI-turn followed by positive evaluation marker within 2 turns.",
      "exclusionCriteria": "High-surprisal turns triggered by user topic-shift rather than AI-initiated reframing."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0370",
      "name": "The Pet Lookup",
      "description": "The use of AI for quick information gathering on pet care questions — feeding, behavior, health prevention, species-appropriate husbandry. Describes a specific everyday application of Just-in-Time Competence (AUG-0043). Related to AUG-0251 (The Kitchen Table) and AUG-0216 (The Parenting Update).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0370",
      "about": "compendium",
      "operationalDefinition": "The Pet Lookup is observed when participants delegate to AI a recurring narrow factual lookup-pattern (named for the canonical example of looking up pet-care facts) characterised by repeated topical scope and minimal context-variation across instances.",
      "measurementSchema": "Sequence alignment (Needleman-Wunsch algorithm) applied to query-strings within a single participant across 14 days, identifying high-alignment-score query-clusters as Pet-Lookup-patterns. Pattern-strength = alignment-score normalised by query-length.",
      "exampleData": "{\"participant\": \"P041\", \"queries_total\": 87, \"lookup_clusters_detected\": 5, \"max_alignment_score\": 0.84, \"largest_cluster_size\": 12, \"lookup_share_pct\": 14}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0370.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0345.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0089.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0711.html"
      ],
      "inclusionCriteria": "At least 30 queries per participant within the observation window.",
      "exclusionCriteria": "Single-instance queries with no recurrence."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0430",
      "name": "The Vintage Loop",
      "description": "The return to an old, proven AI workflow after a new approach did not bring the desired success — the recognition that the established sometimes works better than the newest. Related to AUG-0382 (The Architect's Exit), AUG-0277 (The Loyalty Glitch), and AUG-0207 (The Return to Manual).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0430",
      "about": "compendium",
      "operationalDefinition": "The Vintage Loop is observed when participants periodically revisit and re-use older AI outputs (>= 30 days old) as input or reference for current sessions, indicating archival behaviour beyond ephemeral conversation.",
      "measurementSchema": "Page-Rank centrality computed on the participant's session-graph where edges connect sessions that share quoted-content via verbatim or near-verbatim (BLEU > 0.4) matches. Vintage-loop strength = sum of Page-Rank for nodes older than 30 days that appear as edge-sources.",
      "exampleData": "{\"participant\": \"P022\", \"sessions_total\": 84, \"vintage_loop_edges\": 17, \"page_rank_sum_vintage_nodes\": 0.31, \"median_referenced_age_days\": 67}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0430.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0194.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0918.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0520.html"
      ],
      "inclusionCriteria": "Participant with at least 30 days of historical sessions available.",
      "exclusionCriteria": "Edges based on common-phrase or boilerplate matches."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0534",
      "name": "The Hidden Angle Finder",
      "description": "The use of AI to discover a previously unconsidered perspective in a familiar topic — the hidden angle the user would not have found alone. Related to AUG-0248 (The Surprise Angle), AUG-0040 (Perspective Triangulation), and AUG-0225 (The Unexpected Voice).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0534",
      "about": "compendium",
      "operationalDefinition": "The Hidden Angle Finder is observed when AI-assisted analysis surfaces non-obvious perspectives on a problem that the participant did not anticipate in their initial framing, evidenced by explicit acknowledgment-of-novel-angle markers in subsequent turns.",
      "measurementSchema": "Latent growth curve modeling applied to participant's perspective-count over a session, with random-intercept and random-slope. Hidden-Angle events = positive deviations from individual growth-trajectory exceeding 1 SD residual, paired with verbal acknowledgment.",
      "exampleData": "{\"session_id\": \"S109\", \"participant\": \"P040\", \"perspective_count_curve\": \"[2, 3, 5, 8, 12]\", \"deviations_positive_above_1sd\": 2, \"hidden_angle_acknowledged\": 2, \"match_rate\": 1.0}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0534.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0204.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0092.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0975.html"
      ],
      "inclusionCriteria": "Sessions with serial perspective-listing across at least 5 timepoints.",
      "exclusionCriteria": "Sessions where the AI provides angles unprompted without explicit user-acknowledgment."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0639",
      "name": "The Duplicate Notice",
      "description": "The user's recognition that an AI response is substantively a repetition of an earlier response — differently formulated but identical in core. Related to AUG-0560 (The Conversation Loop), AUG-0383 (The Context Collapse), and AUG-0088 (Algorithmic Intuition).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0639",
      "about": "compendium",
      "operationalDefinition": "The Duplicate Notice is observed when participants explicitly flag AI output as substantively similar to previously received output (within or across sessions), characterised by an explicit duplicate-marker phrase and a flagged-output identifier.",
      "measurementSchema": "Cohen-Yates chi-square test (with Yates correction for 2x2) on flagged-duplicate counts vs. expected-by-chance duplicates across n participants. Duplicate-notice rate per participant compared via chi-square goodness-of-fit.",
      "exampleData": "{\"participants_n\": 45, \"duplicate_notices_total\": 89, \"expected_by_chance\": 41, \"chi_square_yates\": 32.7, \"p_value\": 1e-06, \"df\": 1}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0639.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0005.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0220.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0204.html"
      ],
      "inclusionCriteria": "Explicit duplicate-marker phrase AND identifiable referenced prior output.",
      "exclusionCriteria": "Loose similarity claims without explicit prior-output reference."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0675",
      "name": "The Role-Aware Input",
      "description": "An input pattern in which the user incorporates social roles into the formulation — \"As a parent I need…,\" \"In my function as….\" The input is contextualized through the user's role. Related to AUG-0491 (The State Label), AUG-0650 (The Context-Sensitive Query), and AUG-0524 (The Context Layer).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0675",
      "about": "compendium",
      "operationalDefinition": "Role-Aware Input is observed when participants adapt prompt-formulation based on an explicit AI-role assignment (e.g., teacher, critic, brainstormer), measured by detectable lexical and syntactic shifts across role-conditions.",
      "measurementSchema": "Mann-Whitney U test on lexical-feature distributions (formality, hedging, directiveness) between role-conditions within-participant. Role-awareness detected when at least 3 features differ significantly across roles at Bonferroni-corrected p < 0.01.",
      "exampleData": "{\"participant\": \"P059\", \"role_conditions\": 4, \"features_tested\": 8, \"significant_features_after_correction\": 5, \"mean_U_effect_size\": 0.47}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0675.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0565.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0047.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0370.html"
      ],
      "inclusionCriteria": "Participant uses at least 3 distinct AI-roles within the observation window.",
      "exclusionCriteria": "Sessions where role-assignment is implicit only (no explicit role-string)."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0711",
      "name": "The Accent Persistence",
      "description": "The observation that the phonetic patterns of a user's first language show through even in written AI inputs — sentence melody, word order, punctuation, and formulation patterns carry a \"written accent.\" Related to AUG-0683 (The Origin Language), AUG-0691 (The Dialect Decoder), and AUG-0706 (The Mother Tongue Comfort).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0711",
      "about": "compendium",
      "operationalDefinition": "Accent Persistence is observed when stylistic features of a participant's prior writing (idiolect markers) persist in subsequent AI-assisted outputs, even when the AI is prompted toward a neutral style, indicating partial style-transfer resistance.",
      "measurementSchema": "Stylometric distance via cosine similarity on character-n-gram (n=3,4,5) feature-vectors between participant's prior solo-writing and AI-assisted writing. Persistence = similarity > 0.7 above the random-baseline similarity computed across unrelated participant pairs.",
      "exampleData": "{\"participant\": \"P053\", \"prior_corpus_words\": 8200, \"ai_assisted_corpus_words\": 3400, \"ngram_cosine_3\": 0.78, \"ngram_cosine_4\": 0.74, \"baseline_cosine\": 0.31, \"persistence_z_score\": 4.2}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0711.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0204.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0430.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0345.html"
      ],
      "inclusionCriteria": "At least 5000 words of prior solo writing for stable stylometric baseline.",
      "exclusionCriteria": "Participants who explicitly request style-imitation of a different author."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0901",
      "name": "The Emergent Coordination",
      "description": "The observation that in multi-agent systems, coordination patterns can emerge that were not explicitly programmed — the interaction of subsystems produces behavior not intended in the individual systems. Related to AUG-0900 (The Distributed Coordination), AUG-0948 (The Scope Creep Alert), and AUG-0949 (The Unintended Action).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0901",
      "about": "compendium",
      "operationalDefinition": "Emergent Coordination is observed when two or more participants converge on synchronised problem-decomposition strategies during multi-agent AI-mediated work, without explicit coordination instructions, evidenced by aligned task-segmentation across independent agents.",
      "measurementSchema": "Network modularity computed via the Louvain method on the joint task-graph (nodes = sub-tasks, edges = shared dependencies). Coordination-strength = modularity score Q; values Q > 0.3 indicate non-trivial clustering attributable to emergent coordination.",
      "exampleData": "{\"session_id\": \"S233\", \"participants\": [\"P012\", \"P019\", \"P027\"], \"subtasks_total\": 22, \"louvain_modularity_Q\": 0.42, \"clusters_detected\": 4, \"alignment_index\": 0.78}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0901.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0260.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0092.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0435.html"
      ],
      "inclusionCriteria": "Multi-agent session with at least 3 participants and >= 15 sub-tasks.",
      "exclusionCriteria": "Sessions with explicit pre-assigned task-segmentation."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0001",
      "name": "Augmanitai",
      "description": "A framework concept describing the conscious, productive collaboration between humans and AI in everyday contexts. The term combines \"augmentation\" (enhancement) with \"humanitai\" (a neologism for human-centered AI use). Unlike the term \"artificial intelligence,\" which centers the machine, Augmanitai describes exclusively the human perspective during collaboration. Foundational term for the entire framework; referenced across all 21 Axioms, 9 Dimensions, and 7 Phases.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0001",
      "about": "compendium",
      "operationalDefinition": "Augmanitai is observed at the corpus-level when sustained human-AI co-production generates terminology, frameworks, and shared artifacts across a defined longitudinal window, evidenced by terminology-uptake metrics and by spaced-repetition retention of co-produced concepts in participant recall tests.",
      "measurementSchema": "Spaced-repetition retention curve: forgetting-curve fitted to recall-test scores at days 1, 7, 30, 90 for co-produced concepts vs solo-produced concepts. Half-life of retention reported per concept-class. Saccade-tracking eye-fixation on terminology in re-encounter task as secondary measure of recognition.",
      "exampleData": "{\"participant_id\": \"P112\", \"concepts_tracked\": 30, \"co_produced_half_life_days\": 64, \"solo_produced_half_life_days\": 28, \"saccade_fixation_ms_co\": 412, \"saccade_fixation_ms_solo\": 287}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0001.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0775.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0430.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0305.html"
      ],
      "inclusionCriteria": "Retention measured at all four time-points with co-produced half-life at least 1.5x solo-produced half-life.",
      "exclusionCriteria": "Concepts re-encountered between testing windows through external exposure (publications, news) that confound retention-attribution."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0005",
      "name": "The Integrated Operator",
      "description": "A user type who does not treat AI as a separate tool but has seamlessly integrated it into their entire working and thinking process. The Integrated Operator moves fluidly between their own thinking and AI assistance without a conscious \"switching moment.\" Describes an advanced state typically reached in Phase 6 (Integrated Work State). Differs from the Conductor Profile (Profile 12) in that the Integrated Operator merges rather than delegates.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0005",
      "about": "compendium",
      "operationalDefinition": "An Integrated Operator is observed when a participant blends AI-assistance fluidly into a primary task such that AI-mediated steps are not separable into distinct sub-tasks, evidenced by uninterrupted task-flow telemetry and post-task think-aloud reports treating AI as embedded rather than tool-like.",
      "measurementSchema": "Task-flow telemetry: mean time between AI-handoff and task-resumption (target < 8s); think-aloud coding for AI-as-tool vs AI-as-extension framing on a 5-point integration scale. Composite integration-index = (1 - normalized handoff-time) x integration-scale-mean.",
      "exampleData": "{\"task_id\": \"T029\", \"participant\": \"P014\", \"ai_handoffs\": 22, \"mean_handoff_time_s\": 5.4, \"integration_scale_mean\": 4.1, \"integration_index\": 0.78}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0005.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0047.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0330.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0675.html"
      ],
      "inclusionCriteria": "Both telemetry and think-aloud data captured for the same task with consistent integration signals.",
      "exclusionCriteria": "Tasks where AI is consciously bracketed as a separate tool (explicit pause-consult-resume pattern)."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0016",
      "name": "Poly-Categorical Mesh",
      "description": "The ability of an AI-assisted user to simultaneously connect knowledge from different disciplines into a new, interdisciplinary result. This phenomenon becomes possible at this speed and breadth only through AI and instant access to domain knowledge (just-in-time) — a single human without AI would need years of training across multiple disciplines to produce comparable connections. Related to Taxonomy Dimension 9 (Output Depth: Collage vs. Novelty), AUG-0012 (Synthetischer Polymath), and AUG-0043 (Just-in-Time Competence).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0016",
      "about": "compendium",
      "operationalDefinition": "A Poly-Categorical Mesh is observed when a participant's AI-mediated reasoning traverses multiple overlapping ontological categories within a single task without category-collapse, evidenced by category-tag analysis of transcript segments and by network-density measures on the resulting tag-graph.",
      "measurementSchema": "Tag-graph network analysis: each transcript-segment tagged with one or more ontological categories from a controlled vocabulary, then graph constructed with categories as nodes and co-occurrence as edges. Mesh-density = edge-count / (nodes choose 2); fragmentation-resistance = largest-connected-component ratio.",
      "exampleData": "{\"task_id\": \"T078\", \"participant\": \"P109\", \"transcript_segments\": 84, \"categories_invoked\": 12, \"edges\": 28, \"mesh_density\": 0.42, \"lcc_ratio\": 0.94}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0016.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0614.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0999.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0089.html"
      ],
      "inclusionCriteria": "Mesh-density above 0.3 with largest-connected-component ratio above 0.8 across at least 50 transcript segments.",
      "exclusionCriteria": "Single-category dominant tasks where mesh-density is artificially inflated by repeat-tagging of one category."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0047",
      "name": "The Echo Courage",
      "description": "The phenomenon that a user, after a confirming AI interaction, gains more confidence to defend an idea before other people. The AI serves as an initial sounding board: if the idea holds there, the user is more likely to carry it into the real world. Related to AUG-0166 (The Borrowed Confidence) and AUG-0232 (The Courage Click).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0047",
      "about": "compendium",
      "operationalDefinition": "Echo Courage is observed when AI-acknowledgment of a participant's tentative position enables a subsequent more-committed restatement of that position, measured as a confidence-uplift between initial tentative articulation and committed restatement.",
      "measurementSchema": "Bootstrap confidence intervals on the effect-size (Cohen's d) of the confidence-shift between tentative and committed statements, computed with 1000 resamples per participant. Significance reported as 95% CI excluding zero.",
      "exampleData": "{\"session_id\": \"S118\", \"participant\": \"P046\", \"tentative_confidence_mean\": 4.2, \"committed_confidence_mean\": 7.8, \"cohens_d\": 1.24, \"ci_95\": \"[0.89, 1.61]\"}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0047.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0639.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0220.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0711.html"
      ],
      "inclusionCriteria": "At least one tentative statement followed by committed restatement after AI-acknowledgment.",
      "exclusionCriteria": "Statements where AI provides new information rather than acknowledgment."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0092",
      "name": "Output Asymmetry",
      "description": "The phenomenon that the effort required to produce a result drops drastically through AI assistance while the quality and scope of the result can remain equal or increase. Describes the fundamental shift in the input-to-output ratio in the AI era. Related to Phase 6 (Integrated Work State) and AUG-0062 (The Lightness Factor).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0092",
      "about": "compendium",
      "operationalDefinition": "Output Asymmetry is observed when AI produces systematically different output-quality across nominally equivalent input-formulations, measured by output-quality distribution differences between paraphrased prompt pairs.",
      "measurementSchema": "Wilcoxon rank-sum test on output-quality scores between paraphrased prompt pairs, with effect-size r reported. Asymmetry detected when r > 0.3 with p < 0.05 across n >= 30 paraphrased pairs.",
      "exampleData": "{\"session_id\": \"S066\", \"paraphrase_pairs\": 32, \"wilcoxon_W\": 287, \"p_value\": 0.011, \"effect_size_r\": 0.41, \"asymmetry_direction\": \"format-A-favored\"}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0092.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0045.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0330.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0194.html"
      ],
      "inclusionCriteria": "At least 30 paraphrased prompt pairs scored by blind raters.",
      "exclusionCriteria": "Pairs where paraphrase introduces semantic shift greater than 0.15 cosine-distance."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0999",
      "name": "The Forward Assessment",
      "description": "The attempt to assess the future development of the human-AI relationship — acknowledging the fundamental uncertainty of any such assessment. The lexicon documents the current state, not the future. What stands here is a snapshot — not a roadmap. Related to AUG-0998 (The Parallel Development Path), AUG-0853 (The Social Contract Debate), and AUG-1000 (The Open Question).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0999",
      "about": "compendium",
      "operationalDefinition": "The Forward Assessment is observed when a participant uses AI-mediated dialogue to project anticipated outcomes of a current decision across a forward horizon of weeks-to-months, with explicit articulation of decision-branches and their expected downstream consequences. The forward-projection must extend beyond immediate next-step consequences and reference at least two alternative branches.",
      "measurementSchema": "Construal Level Theory (CLT) abstract-vs-concrete coding applied to forward-projection statements: each branch-statement is coded on a 5-point abstractness scale (Trope-Liberman dimensions: temporal, spatial, social, hypothetical). Forward-Assessment-index = mean construal-level x branch-count.",
      "exampleData": "{\"session_id\": \"S210\", \"participant\": \"P051\", \"branches_articulated\": 4, \"mean_construal_level\": 3.6, \"forward_horizon_weeks\": 8, \"forward_assessment_index\": 14.4}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0999.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0016.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0534.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0204.html"
      ],
      "inclusionCriteria": "Explicit forward-projection across at least two branches with construal-level >= 3.",
      "exclusionCriteria": "Single-branch forecasts or projections limited to next 24 hours."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0041",
      "name": "The Scatter Spark",
      "description": "The phenomenon whereby seemingly randomly scattered AI outputs — including those not directly matching the query — trigger unexpected associations and idea connections in the user. Describes the creative value of \"noise\" in AI interactions. Related to AUG-0031 (Semantic Spark) and AUG-0070 (The Surprise Field).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0041",
      "about": "compendium",
      "operationalDefinition": "The Scatter Spark is observed when a single AI prompt-response triggers multiple parallel idea-threads in the participant's subsequent output, evidenced by branching divergence from one anchor to multiple downstream concept-clusters.",
      "measurementSchema": "t-SNE / UMAP embedding-distance applied to subsequent idea-utterances: scatter detected when post-trigger utterances form >= 3 distinct embedding-clusters at silhouette score > 0.4, with each cluster contributing >= 15% of utterances.",
      "exampleData": "{\"session_id\": \"S045\", \"participant\": \"P019\", \"trigger_turn\": 12, \"post_trigger_utterances\": 24, \"umap_clusters\": 4, \"silhouette_score\": 0.52, \"scatter_index\": 3.6}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0041.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0345.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0565.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0534.html"
      ],
      "inclusionCriteria": "Identifiable anchor-turn followed by >= 20 subsequent idea-utterances.",
      "exclusionCriteria": "Sessions where the participant explicitly itemises a pre-defined list."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0194",
      "name": "The Positive Surprise",
      "description": "An AI response that positively exceeds the user's expectations in quality, depth, or perspective. Describes the moment when the AI delivers more than the user expected — thereby increasing trust in the collaboration. Related to AUG-0070 (The Surprise Field), AUG-0031 (Semantic Spark), and AUG-0177 (The Trust Setting).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0194",
      "about": "compendium",
      "operationalDefinition": "The Positive Surprise is observed when AI output exceeds the participant's pre-stated expectation across at least one dimension (depth, relevance, creativity), evidenced by explicit surprise-markers paired with positive evaluation within two turns.",
      "measurementSchema": "Eye-tracking dwell-time per AOI (Area of Interest) on AI-output text-regions immediately after reveal, with surprise-events flagged as dwell-time exceeding baseline + 1.5 SD AND co-occurring with verbal surprise-marker. Positive Surprise rate = events where evaluation marker is positive / total surprise-events.",
      "exampleData": "{\"session_id\": \"S134\", \"participant\": \"P057\", \"surprise_events\": 4, \"mean_dwell_increase_ms\": 820, \"positive_evaluation_concordance\": 0.75, \"rate_per_30min\": 2.0}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0194.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0001.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0981.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0520.html"
      ],
      "inclusionCriteria": "Eye-tracker-validated gaze-data on AI-output AOIs AND verbal-marker coding completed.",
      "exclusionCriteria": "Sessions where text-length variation confounds dwell-time comparison."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0220",
      "name": "The Gratitude Paradox",
      "description": "The paradoxical observation that some users thank an AI more genuinely than they thank people — because the fear of social evaluation is absent and gratitude can be expressed uninhibitedly. Related to AUG-0128 (The Gratitude Response), AUG-0241 (The Thank You Reflex), and AUG-0201 (The Proxy Closeness).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0220",
      "about": "compendium",
      "operationalDefinition": "The Gratitude Paradox is observed when participants express gratitude toward AI in inverse proportion to their stated belief in AI sentience, suggesting gratitude functions as a relational stance rather than an attribution of consciousness.",
      "measurementSchema": "Spearman rank-correlation rho between gratitude-marker frequency per session and a validated 10-item AI-Sentience-Belief scale administered post-session. Paradox confirmed when rho < -0.3 across n >= 50 participants.",
      "exampleData": "{\"participants_n\": 62, \"gratitude_marker_mean\": 4.8, \"ai_sentience_belief_mean\": 3.1, \"spearman_rho\": -0.42, \"p_value\": 0.001}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0220.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0901.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0534.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0422.html"
      ],
      "inclusionCriteria": "AI-Sentience-Belief scale completed within 24 hours of session.",
      "exclusionCriteria": "Participants who report performing gratitude for politeness-norms only."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0305",
      "name": "The Seasonal User",
      "description": "A user whose AI intensity fluctuates depending on life phase, project load, or season — sometimes intensive daily use, sometimes weeks-long pauses. Describes the observation that AI use need not be a linear process. Related to AUG-0141 (The Spectrum Framework), AUG-0120 (The Range Framework), and AUG-0316 (The Own Pace).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0305",
      "about": "compendium",
      "operationalDefinition": "The Seasonal User pattern is observed when individual usage rhythms exhibit periodic intensification and dormancy tied to external temporal anchors (work-cycles, academic terms, project-deadlines) rather than uniform usage.",
      "measurementSchema": "Spectral analysis (Fast Fourier Transform) of daily session-count time-series over >= 180 days, with peak-frequency identification. Seasonality detected when power-spectrum peaks correspond to frequencies of 1/7-day, 1/30-day, or 1/90-day with significance via permutation test.",
      "exampleData": "{\"participant\": \"P038\", \"observation_days\": 240, \"fft_peak_frequency_days\": 30.5, \"peak_power\": 18.4, \"permutation_p\": 0.003, \"rhythm_strength\": \"strong\"}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0305.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0045.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0194.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0368.html"
      ],
      "inclusionCriteria": "Minimum 180 days of daily usage data with at least one significant FFT peak.",
      "exclusionCriteria": "Time-series with > 25% missing days or single-session bursts only."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0330",
      "name": "The Source Curiosity",
      "description": "The user's interest in tracing the origin and grounding of AI-generated statements — a productive curiosity about where information comes from, supporting informed evaluation of AI outputs.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0330",
      "about": "compendium",
      "alternateName": "Die Quellen-Neugier",
      "operationalDefinition": "The Source Curiosity pattern is observed when participants probe the provenance of AI-stated facts, characterised by source-asking prompts and downstream engagement with the sources provided.",
      "measurementSchema": "Curiosity and Exploration Inventory (CEI-II) administered alongside log-analysis of source-asking prompts per session. Source-Curiosity = CEI-II stretching subscale x source-asking-rate per session.",
      "exampleData": "{\"participant\": \"P037\", \"cei_ii_stretching\": 28, \"source_asking_rate\": 0.34, \"downstream_source_clicks_pct\": 71, \"source_curiosity_index\": 9.52}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0330.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0614.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0047.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0639.html"
      ],
      "inclusionCriteria": "CEI-II completed within 30 days of session-log window AND at least 20 sessions logged.",
      "exclusionCriteria": "Sessions where AI is configured to suppress source-provision regardless of prompt."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0435",
      "name": "The Dinner Shortcut",
      "description": "The quick AI query for everyday food decisions — \"What can I cook with these ingredients?\", \"What fits as a side dish?\" Describes the lowest-threshold form of AI use in the household. Related to AUG-0266 (The Recipe Riff), AUG-0251 (The Kitchen Table), and AUG-0373 (The Quick Check).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0435",
      "about": "compendium",
      "operationalDefinition": "The Dinner Shortcut is observed when participants employ AI for time-bounded everyday-decision tasks (named for the canonical evening meal-planning case) characterised by short session-duration (< 5 min) and immediate actionable outcome.",
      "measurementSchema": "Latent class analysis on session-feature vectors (duration, turn-count, decision-explicit-output, time-of-day) to identify Dinner-Shortcut class. Class-membership probabilities reported per session; class characterised by short-duration + actionable-output + evening-cluster.",
      "exampleData": "{\"participant\": \"P033\", \"sessions_analysed\": 128, \"dinner_shortcut_class_membership\": 22, \"class_probability_mean\": 0.81, \"mean_duration_min\": 3.4, \"evening_share\": 0.86}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0435.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0981.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0260.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0047.html"
      ],
      "inclusionCriteria": "At least 100 sessions to support stable latent class estimation.",
      "exclusionCriteria": "Sessions exceeding 10 minutes regardless of topic."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0520",
      "name": "The Wiki Wormhole",
      "description": "The phenomenon where a simple AI question leads to a chain of follow-up questions that pulls the user deep into a topic — comparable to the \"Wikipedia hole\" but AI-driven. Related to AUG-0342 (The Curiosity Loop), AUG-0413 (The Infinite Scroll), and AUG-0458 (The Curiosity Drill).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0520",
      "about": "compendium",
      "operationalDefinition": "The Wiki Wormhole is observed when AI-mediated exploration of a starting topic cascades into a multi-hop tangential exploration spanning more than 4 topical hops within one session, measured by topic-graph traversal depth.",
      "measurementSchema": "Lin similarity / Wu-Palmer semantic similarity computed pairwise between consecutive turn-topics using WordNet hierarchy. Wormhole detected when at least 4 consecutive hops register pairwise similarity in the 0.2-0.5 range (semantically related but not identical).",
      "exampleData": "{\"session_id\": \"S179\", \"participant\": \"P056\", \"hops_total\": 7, \"wu_palmer_mean_similarity\": 0.34, \"lin_similarity_mean\": 0.31, \"max_topical_distance\": 6}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0520.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0370.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0711.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0534.html"
      ],
      "inclusionCriteria": "Session with at least 5 distinct topical anchors detectable via topic-model.",
      "exclusionCriteria": "Sessions where the user returns to the original topic after each tangent."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0565",
      "name": "The Balance Filter",
      "description": "The conscious strategy of balancing AI use and non-digital activities — through fixed times, rules, or routines that ensure AI enriches everyday life rather than dominating it. Related to AUG-0074 (Analog Anchors), AUG-0282 (The Dinner Table Pause), and Axiom 7 (The Return Principle).",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0565",
      "about": "compendium",
      "operationalDefinition": "The Balance Filter is observed when participants explicitly request balanced multi-perspective output from AI on a contested topic, evidenced by requests containing balance-markers (both sides, multiple perspectives, pros and cons, fair) paired with downstream evaluation of received balance.",
      "measurementSchema": "Bayesian factor analysis on participant ratings of received output across 5 balance-dimensions (perspective-count, weight-symmetry, citation-balance, tonal-neutrality, missing-perspectives-flagged). Bayes-Factor > 3 against single-factor model indicates multidimensional balance perception.",
      "exampleData": "{\"participant\": \"P048\", \"balance_requests\": 14, \"mean_balance_rating\": 5.6, \"bayes_factor_vs_single_factor\": 8.2, \"factors_identified\": 2}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0565.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0089.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0092.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0005.html"
      ],
      "inclusionCriteria": "Explicit balance-marker in prompt AND downstream rating of received output.",
      "exclusionCriteria": "Implicit balance expectations without explicit marker."
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-0981",
      "name": "The Companion Pattern",
      "description": "The pattern where users integrate AI assistance into daily routines as a steady companion for thinking, drafting, and exploration. Best experienced as complement to human reflection rather than substitute — co-presence rather than replacement.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-0981",
      "about": "compendium",
      "alternateName": "Das Begleiter-Muster",
      "operationalDefinition": "The Companion Pattern is observed when AI-interaction frequency and duration display covariation with the participant's social-availability signals (low when social-network active, high when social-network sparse), measured across at least 60 days of paired data.",
      "measurementSchema": "Mediation analysis via Hayes PROCESS macro (Model 4) with social-network-density as predictor, AI-session-duration as outcome, and perceived-loneliness as mediator. Indirect effect bootstrap CI reported.",
      "exampleData": "{\"participant\": \"P024\", \"observation_days\": 84, \"social_network_density_range\": \"[0.12, 0.71]\", \"indirect_effect_b\": 0.34, \"bootstrap_ci_95\": \"[0.18, 0.52]\", \"mediation_significant\": true}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0981.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-general-phenomenology",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0625.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0670.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0088.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0089.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0435.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-0639.html"
      ],
      "inclusionCriteria": "Paired daily social-network and AI-usage data over >= 60 days.",
      "exclusionCriteria": "Participants with stable social-network density (variance < 0.05)."
    }
  ],
  "contributor": {
    "@type": "SoftwareApplication",
    "name": "Large Language Models (LLMs)",
    "applicationCategory": "AI writing assistant",
    "description": "AI assistance for drafting and editorial support; all content human-directed by Andreas Ehstand."
  },
  "identifier": [
