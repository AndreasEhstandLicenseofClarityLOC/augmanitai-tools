    {
      "@type": "DefinedTerm",
      "@id": "https://augmanitai.com/terms/AUG-1014",
      "name": "Relaxation Edit",
      "description": "Das bewusste Nachbearbeiten eines Textes oder Gesprächs mit dem Ziel, Druck, Härte oder Überforderung sprachlich zu reduzieren.",
      "inDefinedTermSet": "https://augmanitai.com/terms/",
      "termCode": "AUG-1014",
      "alternateName": "Entspannungs-Überarbeitung",
      "inLanguage": "de",
      "about": "fun",
      "operationalDefinition": "A Relaxation Edit is observed when participants intentionally use AI to soften or de-intensify a piece of their own writing, characterised by explicit relax-request prompts and downstream lexical-intensity reduction in output.",
      "measurementSchema": "Big Five personality (NEO-PI-R) Neuroticism facet administered alongside lexical-intensity scoring (VADER-intensity or LIWC affect-intensity) on pre- and post-edit text. Relaxation-Edit effectiveness = intensity-reduction modulated by Neuroticism subscore.",
      "exampleData": "{\"participant\": \"P076\", \"neuroticism_score\": 42, \"intensity_pre\": 0.71, \"intensity_post\": 0.43, \"intensity_reduction\": 0.28, \"modulated_effectiveness\": 0.117}",
      "broader": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "mainEntityOfPage": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1014.html",
      "citation": "https://zenodo.org/communities/augmanitai",
      "inScheme": "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/#topic-humor-affect",
      "relatedTerm": [
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1004.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1046.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1052.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1047.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1053.html",
        "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-tools/terms/AUG-1022.html"
      ],
      "inclusionCriteria": "Explicit soften / relax / tone-down request AND NEO-PI-R Neuroticism facet completed.",
      "exclusionCriteria": "Edits requested in third-person context (editing someone else's text)."
    },
    {
